-- 5. 流暢跟隨（防抖動重點）與 傳槍連線控制
---------------------------------------------------------

local loopConnections = {} -- 紀錄傳送連線
local bringGunConnection = nil
local bringGunActive = false

-- 流暢平滑傳送函數 (防止抖動)
local function smoothTeleport(myHrp, targetCFrame)
	if not myHrp or not targetCFrame then return end
	
	-- 消除速度影響，防止重力物理累積導致抖動
	myHrp.AssemblyLinearVelocity = Vector3.zero
	myHrp.AssemblyAngularVelocity = Vector3.zero
	myHrp.CFrame = targetCFrame
end

-- 傳槍邏輯
local function bringAllGuns()
	if not LocalPlayer.Character then return end
	local myHrp = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
	if not myHrp then return end

	for _, item in ipairs(Workspace:GetDescendants()) do
		if item:IsA("Tool") or item:IsA("Weapon") then
			local handle = item:FindFirstChild("Handle") or item:FindFirstChildOfClass("BasePart")
			if handle then
				-- 將地圖上的槍傳送到玩家手邊/腳下觸發拾取
				handle.CFrame = myHrp.CFrame
				if item:FindFirstChildOfClass("TouchTransmitter") then
					firetouchinterest(myHrp, handle, 0)
					firetouchinterest(myHrp, handle, 1)
				end
			end
		end
	end
end

-- 傳槍按鈕點擊事件（開啟/關閉）
GunBtn.MouseButton1Click:Connect(function()
	bringGunActive = not bringGunActive
	
	if bringGunActive then
		GunBtn.Text = "自動吸槍 / 傳槍: 開"
		GunBtn.BackgroundColor3 = Color3.fromRGB(40, 160, 80)
		
		if bringGunConnection then bringGunConnection:Disconnect() end
		
		-- 每 0.2 秒進行一次吸槍/傳槍，確保流暢不卡頓
		bringGunConnection = task.spawn(function()
			while bringGunActive do
				bringAllGuns()
				task.wait(0.2)
			end
		end)
	else
		-- 完全關閉傳槍
		GunBtn.Text = "自動吸槍 / 傳槍: 關"
		GunBtn.BackgroundColor3 = Color3.fromRGB(130, 80, 220)
		if bringGunConnection then
			bringGunActive = false
			bringGunConnection = nil
		end
	end
end)

