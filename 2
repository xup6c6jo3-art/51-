-- ====================================================================
-- [UI 優化版] Roblox Monster ESP & Dynamic Teleport GUI
-- 說明：採用 CoreGui 優先注入、滾動視窗與動態 CanvasSize 調整
-- ====================================================================

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")

local Player = Players.LocalPlayer
local CoreGui = game:GetService("CoreGui")
local TargetParent = CoreGui or Player:WaitForChild("PlayerGui")

-----------------------------------------------------------------------
-- 1. 清除舊版 UI 與初始化設定
-----------------------------------------------------------------------
if TargetParent:FindFirstChild("MonsterESP_TP_GUI") then
    TargetParent.MonsterESP_TP_GUI:Destroy()
end

local TARGET_MONSTERS = {
    ["Reaper"] = true,
    ["Jack O' Lantern"] = true,
    ["Zombie Brute"] = true
}

local Config = {
    TeleportOffsetY = 20, -- 傳送到怪物上方 20 格
    ESPEnabled = true,   -- 預設開啟 ESP
}

local ActiveESPList = {} -- 儲存 ESP 標籤
local MonsterButtons = {} -- 儲存 UI 上的傳送按鈕
local ScrollFrameRef = nil
local UIListLayoutRef = nil
local EspButtonRef = nil

-----------------------------------------------------------------------
-- 2. 輔助函式 (血量與傳送)
-----------------------------------------------------------------------
local function GetMonsterHealth(monsterModel)
    local humanoid = monsterModel:FindFirstChildOfClass("Humanoid") 
        or monsterModel:FindFirstChild("human")
    
    if humanoid then
        return humanoid.Health, humanoid.MaxHealth
    end
    return nil, nil
end

local function TeleportToMonster(monsterModel)
    local char = Player.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    
    local targetPart = monsterModel:FindFirstChild("HumanoidRootPart") 
        or monsterModel.PrimaryPart 
        or monsterModel:FindFirstChildWhichIsA("BasePart")
        
    if targetPart then
        char.HumanoidRootPart.CFrame = targetPart.CFrame + Vector3.new(0, Config.TeleportOffsetY, 0)
        print("[TP Success] 已傳送到怪物上方: " .. monsterModel.Name)
    end
end

-----------------------------------------------------------------------
-- 3. ESP 邏輯
-----------------------------------------------------------------------
local function CreateESP(monsterModel)
    if ActiveESPList[monsterModel] then return end

    local head = monsterModel:FindFirstChild("Head") 
        or monsterModel:FindFirstChild("HumanoidRootPart") 
        or monsterModel.PrimaryPart 
        or monsterModel:FindFirstChildWhichIsA("BasePart")
        
    if not head then return end

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "MonsterESP"
    billboard.Adornee = head
    billboard.Size = UDim2.new(0, 160, 0, 50)
    billboard.StudsOffset = Vector3.new(0, 2.5, 0)
    billboard.AlwaysOnTop = true

    local nameLabel = Instance.new("TextLabel")
    nameLabel.Parent = billboard
    nameLabel.Size = UDim2.new(1, 0, 1, 0)
    nameLabel.BackgroundTransparency = 1
    nameLabel.TextColor3 = Color3.fromRGB(255, 60, 60)
    nameLabel.TextStrokeTransparency = 0
    nameLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    nameLabel.TextScaled = true
    nameLabel.Font = Enum.Font.SourceSansBold

    billboard.Parent = monsterModel
    ActiveESPList[monsterModel] = billboard
end

local function RemoveESP(monsterModel)
    if ActiveESPList[monsterModel] then
        ActiveESPList[monsterModel]:Destroy()
        ActiveESPList[monsterModel] = nil
    end
end

local function ToggleESP(enable)
    Config.ESPEnabled = enable
    
    if EspButtonRef then
        if Config.ESPEnabled then
            EspButtonRef.Text = "👁️ ESP 狀態: 已開啟"
            EspButtonRef.BackgroundColor3 = Color3.fromRGB(40, 150, 60)
        else
            EspButtonRef.Text = "👁️ ESP 狀態: 已關閉"
            EspButtonRef.BackgroundColor3 = Color3.fromRGB(150, 40, 40)
        end
    end

    if Config.ESPEnabled then
        for _, obj in ipairs(Workspace:GetChildren()) do
            if TARGET_MONSTERS[obj.Name] then
                CreateESP(obj)
            end
        end
    else
        for monster, _ in pairs(ActiveESPList) do
            RemoveESP(monster)
        end
    end
end

-- ESP 即時距離與血量更新
RunService.RenderStepped:Connect(function()
    if not Config.ESPEnabled then return end

    local char = Player.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")

    for monsterModel, billboard in pairs(ActiveESPList) do
        if monsterModel and monsterModel.Parent and Config.ESPEnabled then
            local health, maxHealth = GetMonsterHealth(monsterModel)
            local textLabel = billboard:FindFirstChildOfClass("TextLabel")
            
            if textLabel and health then
                local distStr = ""
                local targetPart = monsterModel:FindFirstChild("HumanoidRootPart") or monsterModel.PrimaryPart
                if hrp and targetPart then
                    local dist = math.floor((hrp.Position - targetPart.Position).Magnitude)
                    distStr = string.format(" [%dm]", dist)
                end
                
                textLabel.Text = string.format("%s%s\nHP: %d / %d", monsterModel.Name, distStr, math.floor(health), math.floor(maxHealth))
            end
        else
            RemoveESP(monsterModel)
        end
    end
end)

-----------------------------------------------------------------------
-- 4. 動態更新 UI 滾動高度與傳送按鈕
-----------------------------------------------------------------------
local function UpdateCanvasSize()
    if ScrollFrameRef and UIListLayoutRef then
        ScrollFrameRef.CanvasSize = UDim2.new(0, 0, 0, UIListLayoutRef.AbsoluteContentSize.Y + 10)
    end
end

local function AddMonsterTPButton(monsterModel)
    if MonsterButtons[monsterModel] or not ScrollFrameRef then return end

    local btn = Instance.new("TextButton")
    btn.Name = monsterModel.Name .. "_Btn"
    btn.Parent = ScrollFrameRef
    btn.Size = UDim2.new(1, -8, 0, 30)
    btn.BackgroundColor3 = Color3.fromRGB(50, 50, 55)
    btn.BorderSizePixel = 0
    btn.Text = "⚔️ 傳送至: " .. monsterModel.Name
    btn.TextColor3 = Color3.fromRGB(240, 240, 240)
    btn.TextSize = 13
    btn.Font = Enum.Font.SourceSans

    btn.MouseButton1Click:Connect(function()
        TeleportToMonster(monsterModel)
    end)

    MonsterButtons[monsterModel] = btn
    UpdateCanvasSize()
end

local function RemoveMonsterTPButton(monsterModel)
    if MonsterButtons[monsterModel] then
        MonsterButtons[monsterModel]:Destroy()
        MonsterButtons[monsterModel] = nil
        UpdateCanvasSize()
    end
end

-----------------------------------------------------------------------
-- 5. 主介面建立 (比照 51 區樣式)
-----------------------------------------------------------------------
local function BuildUI()
    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = "MonsterESP_TP_GUI"
    ScreenGui.Parent = TargetParent
    ScreenGui.ResetOnSpawn = false

    local MainFrame = Instance.new("Frame")
    MainFrame.Name = "MainFrame"
    MainFrame.Parent = ScreenGui
    MainFrame.BackgroundColor3 = Color3.fromRGB(28, 28, 30)
    MainFrame.BorderSizePixel = 0
    MainFrame.Position = UDim2.new(0.05, 0, 0.15, 0)
    MainFrame.Size = UDim2.new(0, 260, 0, 380)
    MainFrame.Active = true
    MainFrame.Draggable = true

    -- 標題欄
    local Title = Instance.new("TextLabel")
    Title.Parent = MainFrame
    Title.Size = UDim2.new(1, 0, 0, 36)
    Title.BackgroundColor3 = Color3.fromRGB(18, 18, 20)
    Title.BorderSizePixel = 0
    Title.Text = "怪物偵測與傳送控制台"
    Title.TextColor3 = Color3.fromRGB(255, 255, 255)
    Title.TextSize = 16
    Title.Font = Enum.Font.SourceSansBold

    -- ESP 開關按鈕 (固定放在頂部)
    local espBtn = Instance.new("TextButton")
    espBtn.Name = "ESP_Toggle_Btn"
    espBtn.Parent = MainFrame
    espBtn.Position = UDim2.new(0, 5, 0, 42)
    espBtn.Size = UDim2.new(1, -10, 0, 32)
    espBtn.BorderSizePixel = 0
    espBtn.Font = Enum.Font.SourceSansBold
    espBtn.TextSize = 14
    espBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    
    EspButtonRef = espBtn
    espBtn.MouseButton1Click:Connect(function()
        ToggleESP(not Config.ESPEnabled)
    end)

    -- 分類小標題
    local SubHeader = Instance.new("TextLabel")
    SubHeader.Parent = MainFrame
    SubHeader.Position = UDim2.new(0, 5, 0, 78)
    SubHeader.Size = UDim2.new(1, -10, 0, 24)
    SubHeader.BackgroundColor3 = Color3.fromRGB(45, 45, 50)
    SubHeader.BorderSizePixel = 0
    SubHeader.Text = "  👾 場上怪物一覽 (點擊傳送)"
    SubHeader.TextColor3 = Color3.fromRGB(255, 215, 0)
    SubHeader.TextSize = 13
    SubHeader.TextXAlignment = Enum.TextXAlignment.Left
    SubHeader.Font = Enum.Font.SourceSansBold

    -- 滾動清單
    local Scroll = Instance.new("ScrollingFrame")
    Scroll.Parent = MainFrame
    Scroll.Position = UDim2.new(0, 5, 0, 106)
    Scroll.Size = UDim2.new(1, -10, 1, -112)
    Scroll.BackgroundTransparency = 1
    Scroll.BorderSizePixel = 0
    Scroll.ScrollBarThickness = 6
    ScrollFrameRef = Scroll

    local UIListLayout = Instance.new("UIListLayout")
    UIListLayout.Parent = Scroll
    UIListLayout.SortOrder = Enum.SortOrder.LayoutOrder
    UIListLayout.Padding = UDim.new(0, 4)
    UIListLayoutRef = UIListLayout

    -- 初始狀態同步
    ToggleESP(Config.ESPEnabled)
end

-----------------------------------------------------------------------
-- 6. 怪物自動掃描與監聽
-----------------------------------------------------------------------
local function CheckAndRegisterMonster(child)
    if TARGET_MONSTERS[child.Name] then
        print("[Monster Found] 發現怪物: " .. child.Name)
        
        if Config.ESPEnabled then
            CreateESP(child)
        end
        AddMonsterTPButton(child)

        child.Destroying:Connect(function()
            RemoveESP(child)
            RemoveMonsterTPButton(child)
        end)
    end
end

-- 啟動 UI 介面
BuildUI()

-- 註冊現有怪物
for _, child in ipairs(Workspace:GetChildren()) do
    CheckAndRegisterMonster(child)
end

-- 監聽新怪物生成
Workspace.ChildAdded:Connect(CheckAndRegisterMonster)

print("怪物 ESP & 傳送 UI 載入成功！")
