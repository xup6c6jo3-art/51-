		loopEnabled = not loopEnabled
		
		if loopEnabled then
			LoopTpBtn.Text = "持續傳送: 開"
			LoopTpBtn.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
			
			-- 解除舊的連線 (如果有)
			if loopConnections[config.name] then
				loopConnections[config.name]:Disconnect()
			end
			
