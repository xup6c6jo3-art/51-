-- ====================================================================
-- [除錯相容版] Monster ESP & TP (強制顯示 GUI)
-- ====================================================================

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")

local Player = Players.LocalPlayer
local PlayerGui = Player:WaitForChild("PlayerGui")

-- 優先順序：PlayerGui -> CoreGui (防止部分執行器權限問題)
local TargetParent = PlayerGui

if TargetParent:FindFirstChild("MonsterESP_TP_GUI_V3") then
    TargetParent.MonsterESP_TP_GUI_V3:Destroy()
end

-- 1. 目標怪物清單 (若不確定名稱，可將下方的 AutoDetectMonsters 改為 true)
local TARGET_MONSTERS = {
    ["Reaper"] = true,
    ["Jack O' Lantern"] = true,
    ["Zombie Brute"] = true
}

local Config = {
    TeleportOffsetY = 20,
    ESPEnabled = true,
    AutoDetectMonsters = true -- 自動偵測所有帶有 Humanoid 的 NPC/怪物
}

local ActiveESPList = {}
local MonsterButtons = {}
local ScrollFrameRef = nil
local UIListLayoutRef = nil
local EspButtonRef = nil

local function GetMonsterHealth(monsterModel)
    local humanoid = monsterModel:FindFirstChildOfClass("Humanoid")
    if humanoid then
        return humanoid.Health, humanoid.MaxHealth
    end
    return nil, nil
end

local function TeleportToMonster(monsterModel)
    local char = Player.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    
    local targetPart = monsterModel:FindFirstChild("HumanoidRootPart") 
        or monsterModel.PrimaryPart 
        or monsterModel:FindFirstChildWhichIsA("BasePart")
        
    if targetPart then
        char.HumanoidRootPart.CFrame = targetPart.CFrame + Vector3.new(0, Config.TeleportOffsetY, 0)
        print("[TP] 傳送成功: " .. monsterModel.Name)
    end
end

local function CreateESP(monsterModel)
    if ActiveESPList[monsterModel] then return end

    local head = monsterModel:FindFirstChild("Head") 
        or monsterModel:FindFirstChild("HumanoidRootPart") 
        or monsterModel.PrimaryPart 
        or monsterModel:FindFirstChildWhichIsA("BasePart")
        
    if not head then return end

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "MonsterESP"
    billboard.Adornee = head
    billboard.Size = UDim2.new(0, 160, 0, 50)
    billboard.StudsOffset = Vector3.new(0, 2.5, 0)
    billboard.AlwaysOnTop = true

    local nameLabel = Instance.new("TextLabel")
    nameLabel.Parent = billboard
    nameLabel.Size = UDim2.new(1, 0, 1, 0)
    nameLabel.BackgroundTransparency = 1
    nameLabel.TextColor3 = Color3.fromRGB(255, 60, 60)
    nameLabel.TextStrokeTransparency = 0
    nameLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    nameLabel.TextScaled = true
    nameLabel.Font = Enum.Font.SourceSansBold

    billboard.Parent = monsterModel
    ActiveESPList[monsterModel] = billboard
end

local function RemoveESP(monsterModel)
    if ActiveESPList[monsterModel] then
        ActiveESPList[monsterModel]:Destroy()
        ActiveESPList[monsterModel] = nil
    end
end

local function UpdateCanvasSize()
    if ScrollFrameRef and UIListLayoutRef then
        ScrollFrameRef.CanvasSize = UDim2.new(0, 0, 0, UIListLayoutRef.AbsoluteContentSize.Y + 15)
    end
end

local function AddMonsterTPButton(monsterModel)
    if MonsterButtons[monsterModel] or not ScrollFrameRef then return end

    local btn = Instance.new("TextButton")
    btn.Name = monsterModel.Name .. "_Btn"
    btn.Parent = ScrollFrameRef
    btn.Size = UDim2.new(1, -8, 0, 30)
    btn.BackgroundColor3 = Color3.fromRGB(50, 50, 55)
    btn.BorderSizePixel = 0
    btn.Text = "⚔️ 傳送至: " .. monsterModel.Name
    btn.TextColor3 = Color3.fromRGB(240, 240, 240)
    btn.TextSize = 13
    btn.Font = Enum.Font.SourceSans

    btn.MouseButton1Click:Connect(function()
        TeleportToMonster(monsterModel)
    end)

    MonsterButtons[monsterModel] = btn
    UpdateCanvasSize()
end

local function RemoveMonsterTPButton(monsterModel)
    if MonsterButtons[monsterModel] then
        MonsterButtons[monsterModel]:Destroy()
        MonsterButtons[monsterModel] = nil
        UpdateCanvasSize()
    end
end

