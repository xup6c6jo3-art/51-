		if monster and LocalPlayer.Character then
			local myHrp = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
			local targetPart = getMonsterPart(monster)
			
			if myHrp and targetPart then
				local offset = getOffsetDistance()
				myHrp.CFrame = targetPart.CFrame * CFrame.new(0, offset, 0)
			end
		end
	end)

