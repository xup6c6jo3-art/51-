-- 搜尋怪物模型
local function findMonster(monsterName)
	local monster = Workspace:FindFirstChild(monsterName)
	if monster then return monster end
	for _, child in ipairs(Workspace:GetChildren()) do
		if child.Name == monsterName then
			return child
		end
	end
	return nil
end

-- ESP高亮與BillboardGui (顯示名稱與血量)
local function applyESP(monster, enable)
	if not monster then return end
	
	local existingHighlight = monster:FindFirstChild("MonsterESP_Highlight")
	local existingBillboard = monster:FindFirstChild("MonsterESP_Billboard")

	if enable then
		-- 高亮外框
		if not existingHighlight then
			local highlight = Instance.new("Highlight")
			highlight.Name = "MonsterESP_Highlight"
			highlight.FillColor = Color3.fromRGB(255, 50, 50)
			highlight.FillTransparency = 0.5
			highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
			highlight.OutlineTransparency = 0
			highlight.Parent = monster
		end

		-- 頭頂血量顯示牌
		if not existingBillboard then
			local head = monster:FindFirstChild("Head") or monster:FindFirstChild("HumanoidRootPart") or monster.PrimaryPart
			if head then
				local bb = Instance.new("BillboardGui")
				bb.Name = "MonsterESP_Billboard"
				bb.Adornee = head
				bb.Size = UDim2.new(0, 150, 0, 45)
				bb.StudsOffset = Vector3.new(0, 3.5, 0)
				bb.AlwaysOnTop = true

				local nameText = Instance.new("TextLabel")
				nameText.Name = "NameLabel"
				nameText.Size = UDim2.new(1, 0, 0, 20)
				nameText.BackgroundTransparency = 1
				nameText.Text = monster.Name
				nameText.TextColor3 = Color3.fromRGB(255, 255, 255)
				nameText.TextStrokeTransparency = 0
				nameText.Font = Enum.Font.SourceSansBold
				nameText.TextSize = 14
				nameText.Parent = bb

				local hpText = Instance.new("TextLabel")
				hpText.Name = "HPLabel"
				hpText.Position = UDim2.new(0, 0, 0, 20)
				hpText.Size = UDim2.new(1, 0, 0, 20)
				hpText.BackgroundTransparency = 1
				hpText.TextColor3 = Color3.fromRGB(50, 255, 100)
				hpText.TextStrokeTransparency = 0
				hpText.Font = Enum.Font.SourceSans
				hpText.TextSize = 13
				hpText.Parent = bb

				bb.Parent = monster
			end
		end
	else
		if existingHighlight then existingHighlight:Destroy() end
		if existingBillboard then existingBillboard:Destroy() end
	end
end

-- 實時更新血量文字
RunService.RenderStepped:Connect(function()
	for _, config in ipairs(MONSTERS) do
		local monster = findMonster(config.name)
		if monster then
			local bb = monster:FindFirstChild("MonsterESP_Billboard")
			if bb and bb:FindFirstChild("HPLabel") then
				local humanoid = monster:FindFirstChildOfClass("Humanoid")
				if humanoid then
					local hp = math.max(0, math.floor(humanoid.Health))
					local maxHp = math.floor(humanoid.MaxHealth)
					bb.HPLabel.Text = string.format("HP: %d / %d", hp, maxHp)
					
					-- 低血量自動變色
					local pct = hp / math.max(1, maxHp)
					bb.HPLabel.TextColor3 = Color3.fromHSV(pct * 0.3, 1, 1)
				else
					bb.HPLabel.Text = "HP: N/A"
				end
			end
		end
	end
end)

