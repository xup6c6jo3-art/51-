				if monster and LocalPlayer.Character then
					local myHrp = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
					local targetPart = getMonsterPart(monster)
					
					if myHrp and targetPart then
						local offset = getOffsetDistance()
						myHrp.CFrame = targetPart.CFrame * CFrame.new(0, offset, 0)
					end
				end
			end)
		else
			LoopTpBtn.Text = "持續傳送: 關"
			LoopTpBtn.BackgroundColor3 = Color3.fromRGB(70, 70, 75)
			
			if loopConnections[config.name] then
				loopConnections[config.name]:Disconnect()
				loopConnections[config.name] = nil
			end
		end
	end)

	UI_Rows[config.name] = {
		Row = Row,
		NameLabel = NameLabel,
		EspBtn = EspBtn,
		TpBtn = TpBtn,
		DistanceBox = DistanceBox,
		LoopTpBtn = LoopTpBtn,
		GetEspState = function() return espEnabled end,
		StopLoop = function()
			loopEnabled = false
			LoopTpBtn.Text = "持續傳送: 關"
			LoopTpBtn.BackgroundColor3 = Color3.fromRGB(70, 70, 75)
			if loopConnections[config.name] then
				loopConnections[config.name]:Disconnect()
				loopConnections[config.name] = nil
			end
		end
	}
end

-- 6. 監聽狀態更新（存在亮起，不存在變灰）
local function updateUIStates()
	for _, config in ipairs(MONSTERS) do
		local data = UI_Rows[config.name]
		if data then
			local monster = findMonster(config.name)
			local isAlive = (monster ~= nil)

			if isAlive then
				data.Row.BackgroundTransparency = 0
				data.NameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
				
				data.EspBtn.Active = true
				data.EspBtn.AutoButtonColor = true
				data.EspBtn.TextTransparency = 0
				
				data.TpBtn.Active = true
				data.TpBtn.AutoButtonColor = true
				data.TpBtn.BackgroundColor3 = Color3.fromRGB(0, 122, 255)
				data.TpBtn.TextTransparency = 0
				
				data.DistanceBox.TextEditable = true
				data.DistanceBox.TextTransparency = 0
				
				data.LoopTpBtn.Active = true
				data.LoopTpBtn.AutoButtonColor = true
				data.LoopTpBtn.TextTransparency = 0
				
				if data.GetEspState() then
					applyESP(monster, true)
				end
			else
				-- 怪物消失時自動關閉持續傳送
				data.StopLoop()
				
				data.Row.BackgroundTransparency = 0.5
				data.NameLabel.TextColor3 = Color3.fromRGB(120, 120, 120)
				
				data.EspBtn.Active = false
				data.EspBtn.AutoButtonColor = false
				data.EspBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 50)
				data.EspBtn.TextTransparency = 0.5
				
				data.TpBtn.Active = false
				data.TpBtn.AutoButtonColor = false
				data.TpBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 55)
				data.TpBtn.TextTransparency = 0.5
				
				data.DistanceBox.TextEditable = false
				data.DistanceBox.TextTransparency = 0.5
				
				data.LoopTpBtn.Active = false
				data.LoopTpBtn.AutoButtonColor = false
				data.LoopTpBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 55)
				data.LoopTpBtn.TextTransparency = 0.5
			end
		end
	end
end

-- 初始化與監聽 Workspace
updateUIStates()

Workspace.ChildAdded:Connect(function(child)
