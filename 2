		EspBtn = EspBtn,
		TpBtn = TpBtn,
		GetEspState = function() return espEnabled end
	}
end

-- 6. 監聽與狀態刷新（亮起 vs 黯淡/不可點擊）
local function updateUIStates()
	for _, config in ipairs(MONSTERS) do
		local data = UI_Rows[config.name]
		if data then
			local monster = findMonster(config.name)
			local isAlive = (monster ~= nil)

			if isAlive then
				-- 有怪物：亮起且可點擊
				data.Row.BackgroundTransparency = 0
				data.NameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
				
				data.EspBtn.Active = true
				data.EspBtn.AutoButtonColor = true
				data.EspBtn.TextTransparency = 0
				
				data.TpBtn.Active = true
				data.TpBtn.AutoButtonColor = true
				data.TpBtn.BackgroundColor3 = Color3.fromRGB(0, 122, 255)
				data.TpBtn.TextTransparency = 0
				
				-- 重新應用 ESP 狀態（防止怪物重新生成後 ESP 消失）
				if data.GetEspState() then
					applyESP(monster, true)
				end
			else
				-- 無怪物：變黯淡且不能按
				data.Row.BackgroundTransparency = 0.5
				data.NameLabel.TextColor3 = Color3.fromRGB(120, 120, 120)
				
				data.EspBtn.Active = false
				data.EspBtn.AutoButtonColor = false
				data.EspBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 50)
				data.EspBtn.TextTransparency = 0.5
				
				data.TpBtn.Active = false
				data.TpBtn.AutoButtonColor = false
				data.TpBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 55)
				data.TpBtn.TextTransparency = 0.5
			end
		end
	end
end

-- 初始刷新與 Workspace 變動監聽
updateUIStates()

Workspace.ChildAdded:Connect(function(child)
	updateUIStates()
end)

Workspace.ChildRemoved:Connect(function(child)
	updateUIStates()
end)
