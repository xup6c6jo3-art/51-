SubHeader.BorderSizePixel = 0
SubHeader.Text = "  👾 場上怪物/NPC 一覽"
SubHeader.TextColor3 = Color3.fromRGB(255, 215, 0)
SubHeader.TextSize = 13
SubHeader.TextXAlignment = Enum.TextXAlignment.Left
SubHeader.Font = Enum.Font.SourceSansBold

local Scroll = Instance.new("ScrollingFrame")
Scroll.Parent = MainFrame
Scroll.Position = UDim2.new(0, 5, 0, 106)
Scroll.Size = UDim2.new(1, -10, 1, -112)
Scroll.BackgroundTransparency = 1
