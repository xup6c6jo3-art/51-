-- =========================================================
-- Roblox 物件沿座標路徑自動排列腳本 (完整擴充版)
-- =========================================================

-- 1. 設定要排列的所有物件清單（依序排列）
local itemsToArrange = {
	-- 原有的物件
	game.Workspace:FindFirstChild("Floor 2") and game.Workspace["Floor 2"]:FindFirstChild("GetHEXGun"),
	game.Workspace:FindFirstChild("Floor 2") and game.Workspace["Floor 2"]:FindFirstChild("GetRedMissile"),
	game.Workspace:FindFirstChild("IceZone") and game.Workspace["IceZone"]:FindFirstChild("GetIceCrossbow"),
	game.Workspace:FindFirstChild("LavaZone") and game.Workspace["LavaZone"]:FindFirstChild("Escape"),
	game.Workspace:FindFirstChild("Exit"),
	
	-- 剛剛新加入的監聽/區域物件
	game.Workspace:FindFirstChild("CorruptedZone") and game.Workspace["CorruptedZone"]:FindFirstChild("RGB - 9999 Cell"),
	game.Workspace:FindFirstChild("DeadGround") and game.Workspace["DeadGround"]:FindFirstChild("LXD - 9999 Cell"),
	game.Workspace:FindFirstChild("Castle") and game.Workspace["Castle"]:FindFirstChild("Scarecrow"),
	game.Workspace:FindFirstChild("CyberLand") and game.Workspace["CyberLand"]:FindFirstChild("GetMechGun"),
	game.Workspace:FindFirstChild("ESCAPE FROM THIS HELL"),
}

-- 過濾掉找不到的物件（避免報錯）
local validItems = {}
for _, item in ipairs(itemsToArrange) do
	if item then 
		table.insert(validItems, item) 
	end
end

-- 2. 設定目標高度 Y = 1148
local TARGET_Y = 1148.00

local Point1 = Vector3.new(596.51, TARGET_Y, 785.83)
local Point2 = Vector3.new(596.69, TARGET_Y, 715.76)
local Point3 = Vector3.new(614.35, TARGET_Y, 782.40)
local Point4 = Vector3.new(614.96, TARGET_Y, 715.58)

local BLOCK_SIZE = 5 -- 每個方塊大小

-- 通用定位函式（支援 Model 與單獨的 BasePart）
local function placeItem(item, targetPos)
	-- 關閉所有碰撞，防止物理引擎自動把物件頂高
	for _, part in ipairs(item:GetDescendants()) do
		if part:IsA("BasePart") then
			part.CanCollide = false
			part.Anchored = true
		end
	end
	if item:IsA("BasePart") then
		item.CanCollide = false
		item.Anchored = true
	end
	
	-- 根據類型進行精準定位
	if item:IsA("Model") then
		local mainPart = item:FindFirstChild("Head") or item.PrimaryPart or item:FindFirstChildOfClass("BasePart")
		if mainPart then
			item.PrimaryPart = mainPart
			item:SetPrimaryPartCFrame(CFrame.new(targetPos))
		else
			item:PivotTo(CFrame.new(targetPos))
		end
	elseif item:IsA("BasePart") then
		item.CFrame = CFrame.new(targetPos)
	end
end

-- 3. 自動排列邏輯
local function arrangeItems()
	print("開始進行全部物件的自動排列...")
	
	local line1Vector = Point2 - Point1
	local line1Length = line1Vector.Magnitude
	local countLine1 = math.floor(line1Length / BLOCK_SIZE)
	
	local line2Vector = Point4 - Point3
	local line2Length = line2Vector.Magnitude
	local countLine2 = math.floor(line2Length / BLOCK_SIZE)
	
	local currentItemIndex = 1
	local totalItems = #validItems
	
	-- 排列第一條線 (Point1 -> Point2)
	for i = 0, countLine1 do
		if currentItemIndex > totalItems then break end
		local alpha = (i * BLOCK_SIZE) / line1Length
		if alpha > 1 then break end
		
		local spawnPos = Point1:Lerp(Point2, alpha)
		local item = validItems[currentItemIndex]
		
		placeItem(item, spawnPos)
		print(string.format("已放置 [%s] 到 (%.2f, %.2f, %.2f)", item.Name, spawnPos.X, spawnPos.Y, spawnPos.Z))
		currentItemIndex = currentItemIndex + 1
	end
	
	-- 排列第二條線 (Point3 -> Point4)
	for i = 0, countLine2 do
		if currentItemIndex > totalItems then break end
		local alpha = (i * BLOCK_SIZE) / line2Length
		if alpha > 1 then break end
		
		local spawnPos = Point3:Lerp(Point4, alpha)
		local item = validItems[currentItemIndex]
		
		placeItem(item, spawnPos)
		print(string.format("已放置 [%s] 到 (%.2f, %.2f, %.2f)", item.Name, spawnPos.X, spawnPos.Y, spawnPos.Z))
		currentItemIndex = currentItemIndex + 1
	end
	
	print("全部物件排列完成！")
end

-- 執行排列
arrangeItems()
