-- =========================================================
-- Roblox 物件沿座標路徑自動排列腳本
-- =========================================================

-- 1. 設定要排列的模型/物件清單（請確保這些物件放在 Workspace 中）
local itemsToArrange = {
	game.Workspace:FindFirstChild("Floor 2") and game.Workspace["Floor 2"]:FindFirstChild("GetHEXGun"),
	game.Workspace:FindFirstChild("Floor 2") and game.Workspace["Floor 2"]:FindFirstChild("GetRedMissile"),
	game.Workspace:FindFirstChild("IceZone") and game.Workspace["IceZone"]:FindFirstChild("GetIceCrossbow"),
	game.Workspace:FindFirstChild("LavaZone") and game.Workspace["LavaZone"]:FindFirstChild("Escape"),
	-- 如果有其他物件，可以繼續加在這裡，例如：
	-- game.Workspace:FindFirstChild("GetHEXGun"),
}

-- 過濾掉未找到的 nil 物件
local validItems = {}
for _, item in ipairs(itemsToArrange) do
	if item then
		table.insert(validItems, item)
	end
end

-- 2. 定義四個關鍵座標點
local Point1 = Vector3.new(596.51, 1000.00, 785.83) -- 第一座標點
local Point2 = Vector3.new(596.69, 1000.00, 715.76) -- 第二座標點

local Point3 = Vector3.new(614.35, 1000.00, 782.40) -- 第三座標點
local Point4 = Vector3.new(614.96, 1000.00, 715.58) -- 第四座標點

local BLOCK_SIZE = 5 -- 每格單位大小 (5x1x5)

-- 移動物件至目標 CFrame 的函式
local function setModelPosition(targetModel, targetPosition)
	if targetModel:IsA("Model") then
		if targetModel.PrimaryPart then
			targetModel:SetPrimaryPartCFrame(CFrame.new(targetPosition))
		else
			targetModel:MoveTo(targetPosition)
		end
	elseif targetModel:IsA("BasePart") then
		targetModel.CFrame = CFrame.new(targetPosition)
	end
end

-- 3. 自動排列邏輯
local function arrangeItems()
	print("開始自動排列物件...")
	
	-- 計算第一條線 (Point1 -> Point2) 的方向與總長度
	local line1Dir = (Point2 - Point1)
	local line1Length = line1Dir.Magnitude
	local countLine1 = math.floor(line1Length / BLOCK_SIZE)
	
	-- 計算第二條線 (Point3 -> Point4) 的方向與總長度
	local line2Dir = (Point4 - Point3)
	local line2Length = line2Dir.Magnitude
	local countLine2 = math.floor(line2Length / BLOCK_SIZE)
	
	local currentItemIndex = 1
	local totalItems = #validItems
	
	-- 先排列第一條線
	for i = 0, countLine1 do
		if currentItemIndex > totalItems then break end
		
		local alpha = (i * BLOCK_SIZE) / line1Length
		if alpha > 1 then break end
		
		local spawnPos = Point1:Lerp(Point2, alpha)
		local item = validItems[currentItemIndex]
		
		setModelPosition(item, spawnPos)
		print(string.format("已放置物件 %s 到第一條線，位置: %s", item.Name, tostring(spawnPos)))
		
		currentItemIndex = currentItemIndex + 1
	end
	
	-- 若還有剩餘物件，繼續排列第二條線
	for i = 0, countLine2 do
		if currentItemIndex > totalItems then break end
		
		local alpha = (i * BLOCK_SIZE) / line2Length
		if alpha > 1 then break end
		
		local spawnPos = Point3:Lerp(Point4, alpha)
		local item = validItems[currentItemIndex]
		
		setModelPosition(item, spawnPos)
		print(string.format("已放置物件 %s 到第二條線，位置: %s", item.Name, tostring(spawnPos)))
		
		currentItemIndex = currentItemIndex + 1
	end
	
	print("所有物件排列完成！")
end

-- 執行排列
arrangeItems()
