-- 1. 條列式精準尋找每一個物件（找不到會明確在 Output 印出提示）
local function findMyItem(pathDescription, finderFunc)
	local success, result = pcall(finderFunc)
	if success and result then
		print("成功找到物件: " .. pathDescription)
		return result
	else
		warn("⚠️ 找不到物件: " .. pathDescription)
		return nil
	end
end

local validItems = {}

-- 收集所有物件
table.insert(validItems, findMyItem("GetHEXGun", function() return game.Workspace["Floor 2"].GetHEXGun end))
table.insert(validItems, findMyItem("GetRedMissile", function() return game.Workspace["Floor 2"].GetRedMissile end))
table.insert(validItems, findMyItem("GetIceCrossbow", function() return game.Workspace.IceZone.GetIceCrossbow end))
table.insert(validItems, findMissing or function() return game.Workspace.LavaZone.Escape end()) -- 修正 Escape 尋找
