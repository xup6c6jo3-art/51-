-- =========================================================
-- Roblox 固定物件初始化 + 傳送門動態監聽排列腳本
-- =========================================================

local TARGET_Y = 1148.00

local Point1 = Vector3.new(596.51, TARGET_Y, 785.83)
local Point2 = Vector3.new(596.69, TARGET_Y, 715.76)
local Point3 = Vector3.new(614.35, TARGET_Y, 782.40)
local Point4 = Vector3.new(614.96, TARGET_Y, 715.58)

local BLOCK_SIZE = 5

-- 預先計算好所有格子的目標座標點陣列
local targetPositions = {}

local function calculatePositions()
	targetPositions = {}
	
	-- 計算第一條線的座標點
	local line1Vector = Point2 - Point1
	local line1Length = line1Vector.Magnitude
	local countLine1 = math.floor(line1Length / BLOCK_SIZE)
	for i = 0, countLine1 do
		local alpha = (i * BLOCK_SIZE) / line1Length
		if alpha > 1 then break end
		table.insert(targetPositions, Point1:Lerp(Point2, alpha))
	end
	
	-- 計算第二條線的座標點
	local line2Vector = Point4 - Point3
	local line2Length = line2Vector.Magnitude
	local countLine2 = math.floor(line2Length / BLOCK_SIZE)
	for i = 0, countLine2 do
		local alpha = (i * BLOCK_SIZE) / line2Length
		if alpha > 1 then break end
		table.insert(targetPositions, Point3:Lerp(Point4, alpha))
	end
end

calculatePositions()

-- 通用定位函式
local function placeItem(item, targetPos)
	for _, part in ipairs(item:GetDescendants()) do
		if part:IsA("BasePart") then
			part.CanCollide = false
			part.Anchored = true
		end
	end
	if item:IsA("BasePart") then
		item.CanCollide = false
		item.Anchored = true
	end
	
	if item:IsA("Model") then
		local mainPart = item:FindFirstChild("Head") or item.PrimaryPart or item:FindFirstChildOfClass("BasePart")
		if mainPart then
			item.PrimaryPart = mainPart
			item:SetPrimaryPartCFrame(CFrame.new(targetPos))
		else
			item:PivotTo(CFrame.new(targetPos))
		end
	elseif item:IsA("BasePart") then
		item.CFrame = CFrame.new(targetPos)
	end
end

-- 1. 原本就有的固定物件清單（對應格子 1 到 5）
local permanentItems = {
	{ name = "GetHEXGun", getter = function() local f = game.Workspace:FindFirstChild("Floor 2") return f and f:FindFirstChild("GetHEXGun") end },
	{ name = "GetRedMissile", getter = function() local f = game.Workspace:FindFirstChild("Floor 2") return f and f:FindFirstChild("GetRedMissile") end },
	{ name = "GetIceCrossbow", getter = function() local f = game.Workspace:FindFirstChild("IceZone") return f and f:FindFirstChild("GetIceCrossbow") end },
	{ name = "Escape", getter = function() local f = game.Workspace:FindFirstChild("LavaZone") return f and f:FindFirstChild("Escape") end },
	{ name = "Exit", getter = function() return game.Workspace:FindFirstChild("Exit") end },
}

-- 2. 傳送門動態物件清單（指定對應的格子編號 slot，每 2 秒檢查一次）
local portalItems = {
	{ slot = 6, getter = function() local f = game.Workspace:FindFirstChild("CorruptedZone") return f and f:FindFirstChild("RGB - 9999 Cell") end },
	{ slot = 7, getter = function() local f = game.Workspace:FindFirstChild("DeadGround") return f and f:FindFirstChild("LXD - 9999 Cell") end },
	{ slot = 8, getter = function() local f = game.Workspace:FindFirstChild("Castle") return f and f:FindFirstChild("Scarecrow") end },
	{ slot = 9, getter = function() local f = game.Workspace:FindFirstChild("CyberLand") return f and f:FindFirstChild("GetMechGun") end },
}

-- 【步驟一】遊戲啟動時，先將固定物件排好一次
print("正在擺放原本就有的固定物件...")
for index, info in ipairs(permanentItems) do
	local success, item = pcall(info.getter)
	if success and item and targetPositions[index] then
		placeItem(item, targetPositions[index])
		print(string.format("已擺放固定物件 [%s] 到位置 %d", info.name, index))
	end
end

-- 【步驟二】啟動背景守護迴圈，每 2 秒檢查一次傳送門有沒有開啓/生成
task.spawn(function()
	print("🌀 傳送門動態監聽守護程序已啟動（每 2 秒檢查一次）...")
	while true do
		for _, portal in ipairs(portalItems) do
			local success, item = pcall(portal.getter)
			if success and item and targetPositions[portal.slot] then
				-- 只要傳送門生成了，就立刻把它傳送到對應的格子座標上
				placeItem(item, targetPositions[portal.slot])
			end
		end
		-- 每 2 秒檢查一次
		task.wait(2)
	end
end)
