local validItems = {}

local function addValid(name, item)
	if item then
		print("成功找到物件: " .. name)
		table.insert(validItems, item)
	else
		warn("⚠️ 找不到物件: " .. name)
	end
end

-- 逐層安全尋找所有物件
local floor2 = game.Workspace:FindFirstChild("Floor 2")
local iceZone = game.Workspace:FindFirstChild("IceZone")
local lavaZone = game.Workspace:FindFirstChild("LavaZone")
local corruptedZone = game.Workspace:FindFirstChild("CorruptedZone")
local deadGround = game.Workspace:FindFirstChild("DeadGround")
local castle = game.Workspace:FindFirstChild("Castle")
local cyberLand = game.Workspace:FindFirstChild("CyberLand")
local mazeWorld = game.Workspace:FindFirstChild("MazeWorld")

addValid("GetHEXGun", floor2 and floor2:FindFirstChild("GetHEXGun"))
addValid("GetRedMissile", floor2 and floor2:FindFirstChild("GetRedMissile"))
addValid("GetIceCrossbow", iceZone and iceZone:FindFirstChild("GetIceCrossbow"))
addValid("Escape", lavaZone and lavaZone:FindFirstChild("Escape"))
addValid("Exit", game.Workspace:FindFirstChild("Exit"))
addValid("RGB - 9999 Cell", corruptedZone and corruptedZone:FindFirstChild("RGB - 9999 Cell"))
addValid("LXD - 9999 Cell", deadGround and deadGround:FindFirstChild("LXD - 9999 Cell"))
addValid("Scarecrow", castle and castle:FindFirstChild("Scarecrow"))
addValid("GetMechGun", cyberLand and cyberLand:FindFirstChild("GetMechGun"))
addValid("ESCAPE FROM THIS HELL", mazeWorld and mazeWorld:FindFirstChild("ESCAPE FROM THIS HELL"))

print("總共成功載入並準備排列的物件數量: " .. #validItems)

-- 2. 設定目標高度 Y = 1148
local TARGET_Y = 1148.00

local Point1 = Vector3.new(596.51, TARGET_Y, 785.83)
local Point2 = Vector3.new(596.69, TARGET_Y, 715.76)
local Point3 = Vector3.new(614.35, TARGET_Y, 782.40)
local Point4 = Vector3.new(614.96, TARGET_Y, 715.58)

local BLOCK_SIZE = 5

-- 通用定位函式
local function placeItem(item, targetPos)
	for _, part in ipairs(item:GetDescendants()) do
		if part:IsA("BasePart") then
			part.CanCollide = false
			part.Anchored = true
		end
	end
	if item:IsA("BasePart") then
		item.CanCollide = false
		item.Anchored = true
	end
	
	if item:IsA("Model") then
		local mainPart = item:FindFirstChild("Head") or item.PrimaryPart or item:FindFirstChildOfClass("BasePart")
		if mainPart then
			item.PrimaryPart = mainPart
			item:SetPrimaryPartCFrame(CFrame.new(targetPos))
		else
			item:PivotTo(CFrame.new(targetPos))
		end
	elseif item:IsA("BasePart") then
		item.CFrame = CFrame.new(targetPos)
	end
end

-- 3. 自動排列邏輯
local function arrangeItems()
	local line1Vector = Point2 - Point1
	local line1Length = line1Vector.Magnitude
	local countLine1 = math.floor(line1Length / BLOCK_SIZE)
	
	local line2Vector = Point4 - Point3
	local line2Length = line2Vector.Magnitude
	local countLine2 = math.floor(line2Length / BLOCK_SIZE)
	
	local currentItemIndex = 1
	local totalItems = #validItems
	
	-- 排列第一條線
	for i = 0, countLine1 do
		if currentItemIndex > totalItems then break end
		local alpha = (i * BLOCK_SIZE) / line1Length
		if alpha > 1 then break end
		
		local spawnPos = Point1:Lerp(Point2, alpha)
		local item = validItems[currentItemIndex]
		
		placeItem(item, spawnPos)
		print(string.format("已放置 [%s] 到 (%.2f, %.2f, %.2f)", item.Name, spawnPos.X, spawnPos.Y, spawnPos.Z))
		currentItemIndex = currentItemIndex + 1
	end
	
	-- 排列第二條線
	for i = 0, countLine2 do
		if currentItemIndex > totalItems then break end
		local alpha = (i * BLOCK_SIZE) / line2Length
		if alpha > 1 then break end
		
		local spawnPos = Point3:Lerp(Point4, alpha)
		local item = validItems[currentItemIndex]
		
		placeItem(item, spawnPos)
		print(string.format("已放置 [%s] 到 (%.2f, %.2f, %.2f)", item.Name, spawnPos.X, spawnPos.Y, spawnPos.Z))
		currentItemIndex = currentItemIndex + 1
	end
	
	print("全部物件排列完成！")
end

arrangeItems()
