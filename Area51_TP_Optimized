---------------------------------------------------------
-- 怪物監聽 (事件驅動，只處理設定清單內的名稱)
---------------------------------------------------------
local function onMonsterAdded(state, monster)
	state.monster = monster
	state.part = nil
	refreshUI(state)

	if state.espOn then
		-- 等零件載入完再掛 ESP
		task.spawn(function()
			monster:WaitForChild("HumanoidRootPart", 3)
			if state.monster == monster and state.espOn then
				applyESP(state)
			end
		end)
	end
end

local function onMonsterRemoved(state)
	if followState == state then stopFollow() end
	removeESP(state)
	state.monster = nil
	state.part = nil
	refreshUI(state)
end

track(Workspace.ChildAdded:Connect(function(child)
	local state = states[child.Name]
	if state then onMonsterAdded(state, child) end
end))

track(Workspace.ChildRemoved:Connect(function(child)
	local state = states[child.Name]
	if state and state.monster == child then onMonsterRemoved(state) end
end))

-- 初始掃描
for _, state in ipairs(stateList) do
	local monster = Workspace:FindFirstChild(state.name)
	if monster then
		onMonsterAdded(state, monster)
	else
		refreshUI(state)
	end
end

---------------------------------------------------------
-- 關閉 / 清理
---------------------------------------------------------
local function destroyAll()
	stopFollow()
	for _, state in ipairs(stateList) do
		removeESP(state)
	end
	disconnectAll(connections)
	disconnectAll(charConns)
	if ScreenGui then ScreenGui:Destroy() end
end

env.Area51TP_Cleanup = destroyAll
CloseBtn.MouseButton1Click:Connect(destroyAll)
