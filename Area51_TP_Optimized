---------------------------------------------------------
-- 角色快取與穿牆
---------------------------------------------------------
local character, rootPart
local charParts = {}       -- [BasePart] = true
local originalCollide = {} -- [BasePart] = 原始 CanCollide
local charConns = {}

local function bindCharacter(newChar)
	disconnectAll(charConns)
	table.clear(charParts)
	table.clear(originalCollide)

	character = newChar
	rootPart = nil
	if not newChar then return end

	rootPart = newChar:FindFirstChild("HumanoidRootPart")
	if not rootPart then
		task.spawn(function()
			local hrp = newChar:WaitForChild("HumanoidRootPart", 10)
			if character == newChar then rootPart = hrp end
		end)
	end

	for _, d in ipairs(newChar:GetDescendants()) do
		if d:IsA("BasePart") then charParts[d] = true end
	end
	table.insert(charConns, newChar.DescendantAdded:Connect(function(d)
		if d:IsA("BasePart") then charParts[d] = true end
	end))
	table.insert(charConns, newChar.DescendantRemoving:Connect(function(d)
		charParts[d] = nil
		originalCollide[d] = nil
	end))
end

local function applyNoclip()
	for part in pairs(charParts) do
		if originalCollide[part] == nil then
			originalCollide[part] = part.CanCollide
		end
		part.CanCollide = false
	end
end

local function restoreCollision()
	for part, original in pairs(originalCollide) do
		if part.Parent then
			part.CanCollide = original
		end
	end
	table.clear(originalCollide)
end

track(LocalPlayer.CharacterAdded:Connect(bindCharacter))
bindCharacter(LocalPlayer.Character)

---------------------------------------------------------
-- 怪物 Part 查找 (有快取)
---------------------------------------------------------
local function resolvePart(monster)
	if monster:IsA("Model") and monster.PrimaryPart then
		return monster.PrimaryPart
	end

	local hrp = monster:FindFirstChild("HumanoidRootPart")
	if hrp and hrp:IsA("BasePart") then return hrp end

	local fallback
	for _, child in ipairs(monster:GetChildren()) do
		if child:IsA("BasePart") then
			if child.Name:find("Torso") or child.Name:find("Body") then
				return child
			end
			fallback = fallback or child
		end
	end
	return fallback
end

local function getPart(state)
	local monster = state.monster
	if not monster then return nil end

	local part = state.part
	if part and part:IsDescendantOf(monster) then
		return part
	end

	part = resolvePart(monster)
	state.part = part
	return part
end

---------------------------------------------------------
-- ESP (血量由 HealthChanged 驅動)
---------------------------------------------------------
local function removeESP(state)
	if state.espConn then
		state.espConn:Disconnect()
		state.espConn = nil
	end
	if state.highlight then
		state.highlight:Destroy()
		state.highlight = nil
	end
	if state.billboard then
		state.billboard:Destroy()
		state.billboard = nil
	end
	state.hpLabel = nil
	state.humanoid = nil
end

local function updateHP(state)
	local label, hum = state.hpLabel, state.humanoid
	if not (label and hum) then return end

	local maxHp = math.max(1, math.floor(hum.MaxHealth))
	local hp = math.clamp(math.floor(hum.Health), 0, maxHp)
	label.Text = string.format("HP: %d / %d", hp, maxHp)
	label.TextColor3 = Color3.fromHSV(hp / maxHp * 0.3, 1, 1)
end

local function applyESP(state)
	removeESP(state)

	local monster = state.monster
	if not monster then return end

	local highlight = Instance.new("Highlight")
	highlight.Name = "MonsterESP_Highlight"
	highlight.FillColor = Color3.fromRGB(255, 50, 50)
	highlight.FillTransparency = 0.5
	highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
	highlight.OutlineTransparency = 0
	highlight.Parent = monster
	state.highlight = highlight

	local part = getPart(state)
	if not part then return end

	local bb = Instance.new("BillboardGui")
	bb.Name = "MonsterESP_Billboard"
	bb.Adornee = part
	bb.Size = UDim2.new(0, 150, 0, 45)
	bb.StudsOffset = Vector3.new(0, 4, 0)
	bb.AlwaysOnTop = true

	local nameText = Instance.new("TextLabel")
	nameText.Name = "NameLabel"
	nameText.Size = UDim2.new(1, 0, 0, 20)
	nameText.BackgroundTransparency = 1
	nameText.Text = monster.Name
	nameText.TextColor3 = COLORS.Text
	nameText.TextStrokeTransparency = 0
	nameText.Font = Enum.Font.SourceSansBold
	nameText.TextSize = 14
	nameText.Parent = bb

	local hpText = Instance.new("TextLabel")
	hpText.Name = "HPLabel"
	hpText.Position = UDim2.new(0, 0, 0, 20)
	hpText.Size = UDim2.new(1, 0, 0, 20)
	hpText.BackgroundTransparency = 1
	hpText.TextColor3 = Color3.fromRGB(50, 255, 100)
	hpText.TextStrokeTransparency = 0
	hpText.Font = Enum.Font.SourceSans
	hpText.TextSize = 13
	hpText.Parent = bb

	bb.Parent = monster
	state.billboard = bb
	state.hpLabel = hpText

	local humanoid = monster:FindFirstChildOfClass("Humanoid")
	if humanoid then
		state.humanoid = humanoid
		updateHP(state)
		state.espConn = humanoid.HealthChanged:Connect(function()
			updateHP(state)
		end)
	else
		hpText.Text = "HP: 在場"
	end
end

---------------------------------------------------------
-- 傳送邏輯
---------------------------------------------------------
-- 只取怪物位置，保留自己的朝向，避免跟著怪物旋轉而歪斜
local function computeCFrame(root, part, offset)
	local pos = part.Position + Vector3.new(0, offset, 0)
	return CFrame.new(pos) * (root.CFrame - root.Position)
end

local function teleportOnce(state)
	local part = getPart(state)
	if part and rootPart and rootPart.Parent then
		rootPart.AssemblyLinearVelocity = Vector3.zero
		rootPart.CFrame = computeCFrame(rootPart, part, state.offset)
	end
end

local function stopFollow()
	if followConn then
		followConn:Disconnect()
		followConn = nil
	end
	local prev = followState
	followState = nil
	restoreCollision()
	if prev then refreshUI(prev) end
end

local function startFollow(state)
	if followState == state then return end

	local prev = followState
	followState = state
	if prev then refreshUI(prev) end
	refreshUI(state)

	if followConn then return end -- 迴圈已在跑，只是切換目標

	-- Stepped：在物理模擬前鎖定位置，避免物理反彈抖動
	followConn = RunService.Stepped:Connect(function()
		local s = followState
		if not (s and s.monster and rootPart and rootPart.Parent) then return end

		local part = getPart(s)
		if not part then return end

		applyNoclip()
		rootPart.AssemblyLinearVelocity = Vector3.zero
		rootPart.AssemblyAngularVelocity = Vector3.zero
		rootPart.CFrame = computeCFrame(rootPart, part, s.offset)
	end)
end

