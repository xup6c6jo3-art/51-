local function setEnabled(btn, enabled, color)
	btn.Active = enabled
	btn.AutoButtonColor = enabled
	btn.BackgroundColor3 = enabled and color or COLORS.Disabled
	btn.TextTransparency = enabled and 0 or 0.5
end

refreshUI = function(state)
	local ui = state.ui
	if not ui or not ui.Row.Parent then return end

	local alive = state.monster ~= nil
	local following = (followState == state)

	ui.Row.BackgroundTransparency = alive and 0 or 0.5
	ui.NameLabel.TextColor3 = alive and COLORS.Text or COLORS.Dim
	ui.Status.Text = alive and "● 在場" or "○ 不在場"
	ui.Status.TextColor3 = alive and Color3.fromRGB(60, 200, 100) or COLORS.Dim

	-- ESP 永遠可切換，怪物出現時會自動套用
	ui.EspBtn.Text = state.espOn and "ESP: 開" or "ESP"
	ui.EspBtn.BackgroundColor3 = state.espOn and COLORS.Green or COLORS.EspOff

	setEnabled(ui.TpBtn, alive, COLORS.Blue)
	setEnabled(ui.LoopBtn, alive, following and COLORS.Red or COLORS.Button)
	ui.LoopBtn.Text = following and "持續傳送: 開" or "持續傳送: 關"

	ui.DistanceBox.TextTransparency = alive and 0 or 0.5
end

