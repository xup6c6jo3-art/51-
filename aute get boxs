local DYNAMIC = "Dyn" -- 動態項目的名稱標記,重新整理時只清除這些

local function createHeader(text, order, dynamic)
    local h = Instance.new("TextLabel")
    h.Name = dynamic and DYNAMIC or "Static"
    h.LayoutOrder = order
    h.Size = UDim2.new(1, -8, 0, 26)
    h.BackgroundColor3 = Color3.fromRGB(45, 45, 50)
    h.BorderSizePixel = 0
    h.Text = "  " .. text
    h.TextColor3 = Color3.fromRGB(255, 215, 0)
    h.TextSize = 14
    h.TextXAlignment = Enum.TextXAlignment.Left
    h.Font = Enum.Font.SourceSansBold
    h.Parent = Scroll
    return h
end

local function createBtn(text, order, dynamic, enabled, callback)
    local b = Instance.new("TextButton")
    b.Name = dynamic and DYNAMIC or "Static"
    b.LayoutOrder = order
    b.Size = UDim2.new(1, -8, 0, 30)
    b.BorderSizePixel = 0
    b.Text = text
    b.TextSize = 13
    b.Font = Enum.Font.SourceSans
    b.BackgroundColor3 = enabled and Color3.fromRGB(50, 50, 55) or Color3.fromRGB(30, 30, 32)
    b.TextColor3 = enabled and Color3.fromRGB(240, 240, 240) or Color3.fromRGB(100, 100, 100)
    b.Active = enabled
    b.AutoButtonColor = enabled
    b.Parent = Scroll
    if enabled and callback then
        b.MouseButton1Click:Connect(callback)
    end
    return b
end

-- 暫時顯示回饋文字
local function flashText(btn, text, restore)
    btn.Text = text
    task.delay(1.2, function()
        if btn.Parent then btn.Text = restore end
    end)
end

-- ==================== 固定區:瞬按 + 自動 ====================
createHeader("快捷瞬按 (" .. INSTANT_RANGE .. "距離內)", 1)
local INSTANT_TEXT = "一鍵瞬按 " .. INSTANT_RANGE .. " 內箱子/球"
local instantBtn = createBtn(INSTANT_TEXT, 2, false, true)
instantBtn.BackgroundColor3 = Color3.fromRGB(70, 90, 150)
instantBtn.Font = Enum.Font.SourceSansBold
instantBtn.MouseButton1Click:Connect(function()
    local hrp = getHRP()
    if not hrp then return end
    local count = 0
    for _, t in ipairs(collectTargets()) do
        if (hrp.Position - t.part.Position).Magnitude <= INSTANT_RANGE and firePrompt(t.object) then
            count += 1
        end
    end
    flashText(instantBtn, string.format("已瞬按 %d 個目標!", count), INSTANT_TEXT)
end)

createHeader("自動模式", 3)
local AUTO_IDLE = "自動依序傳送 (完成後回原位)"
local autoBtn = createBtn(AUTO_IDLE, 4, false, true)
autoBtn.BackgroundColor3 = Color3.fromRGB(60, 120, 70)
autoBtn.Font = Enum.Font.SourceSansBold

local autoRunning = false -- 是否正在執行
local autoCancel = false  -- 是否被要求停止

local function runAuto()
    local hrp = getHRP()
    if not hrp then return end

    local first = collectTargets()
    if #first == 0 then
        flashText(autoBtn, "目前沒有箱子或球", AUTO_IDLE)
        return -- 沒有目標就不動作
    end

    autoRunning, autoCancel = true, false
    local origin = hrp.CFrame
    local visited = {}
    local done = 0

    autoBtn.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
    autoBtn.Text = "自動中… (再按一次停止)"

    while not autoCancel do
        hrp = getHRP()
        if not hrp then break end

        -- 每輪重新掃描,挑最近且尚未去過的目標
        local best, bestDist
        for _, t in ipairs(collectTargets()) do
            if not visited[t.object] then
                local d = (hrp.Position - t.part.Position).Magnitude
                if not bestDist or d < bestDist then
                    best, bestDist = t, d
                end
            end
        end
        if not best then break end -- 全部跑完

        visited[best.object] = true
        if teleportTo(best) then
            done += 1
            autoBtn.Text = string.format("自動中… 第 %d 個 (再按停止)", done)
            task.wait(AUTO_STEP_DELAY)
            if AUTO_FIRE_PROMPT then firePrompt(best.object) end
            task.wait(AUTO_STEP_DELAY)
        end
    end

    -- 最後傳送回原位
    hrp = getHRP()
    if hrp then
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.CFrame = origin
    end

    autoRunning, autoCancel = false, false
    autoBtn.BackgroundColor3 = Color3.fromRGB(60, 120, 70)
    flashText(autoBtn, string.format("完成,共 %d 個,已回原位", done), AUTO_IDLE)
end

autoBtn.MouseButton1Click:Connect(function()
    if autoRunning then
        autoCancel = true
        autoBtn.Text = "停止中…"
    else
        task.spawn(runAuto)
    end
end)

-- ==================== 動態區:箱子 / 球清單 ====================
local function buildSection(title, name, label, startOrder)
    createHeader(title, startOrder, true)
    local list = collectTargets(name)
    if #list == 0 then
        createBtn("目前無可用" .. label .. " (已停用)", startOrder + 1, true, false)
        return startOrder + 2
    end
    for i, t in ipairs(list) do
        createBtn(
            string.format("傳送到%s #%d (Y: %.1f)", label, i, t.part.Position.Y),
            startOrder + i, true, true,
            function() teleportTo(t) end
        )
    end
    return startOrder + #list + 1
end

local function refreshUI()
    for _, child in ipairs(Scroll:GetChildren()) do
        if child.Name == DYNAMIC then child:Destroy() end
    end
    local order = buildSection("補給箱 (SupplyCrate)", "SupplyCrate", "箱子", 10)
    buildSection("補給球 (SupplyBall)", "SupplyBall", "補給球", order + 1)
end

-- 合併短時間內多次更新,避免重複重建
local refreshQueued = false
local function queueRefresh()
    if refreshQueued then return end
    refreshQueued = true
    task.delay(0.3, function()
        refreshQueued = false
        refreshUI()
    end)
end

refreshUI()

workspace.ChildAdded:Connect(function(child)
    if TARGET_NAMES[child.Name] then queueRefresh() end
end)
workspace.ChildRemoved:Connect(function(child)
    if TARGET_NAMES[child.Name] then queueRefresh() end
end)
