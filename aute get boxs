local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

-- ==================== 設定區 ====================
local TARGET_NAMES = { SupplyCrate = true, SupplyBall = true }
local MAX_Y = 5000                        -- 超過此高度的物件視為無效
local INSTANT_RANGE = 30                  -- 一鍵瞬按距離
local BALL_POSITION = Vector3.new(0, 0, 0) -- 補給球的傳送點
local CRATE_OFFSET = Vector3.new(0, 3, 0)   -- 箱子傳送時相對箱子的偏移
local AUTO_SCAN_INTERVAL = 0.5            -- 自動模式:待命時掃描間隔(秒)
local AUTO_SETTLE_DELAY = 0.4             -- 自動模式:傳送後等待多久再按
local AUTO_PRESS_TIMEOUT = 2.5            -- 自動模式:單一目標最多嘗試按多久(秒)
local AUTO_PRESS_INTERVAL = 0.3           -- 自動模式:重複按的間隔(秒)

-- ==================== 工具函式 ====================
local function getHRP()
    local char = LocalPlayer.Character
    return char and char:FindFirstChild("HumanoidRootPart")
end

local function getObjectPart(obj)
    if not obj then return nil end
    if obj:IsA("BasePart") then return obj end
    if obj:IsA("Model") then
        return obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart", true)
    end
    return obj:FindFirstChildWhichIsA("BasePart", true)
end

-- 收集有效目標,name 為 nil 時收集全部類型
local function collectTargets(name)
    local list = {}
    for _, obj in ipairs(workspace:GetChildren()) do
        if TARGET_NAMES[obj.Name] and (not name or obj.Name == name) then
            local part = getObjectPart(obj)
            if part and part.Position.Y <= MAX_Y then
                table.insert(list, { object = obj, part = part, name = obj.Name })
            end
        end
    end
    return list
end

-- 球傳到 BALL_POSITION,箱子傳到箱子上方
local function teleportTo(target)
    local hrp = getHRP()
    if not hrp or not target.object.Parent then return false end
    local pos
    if target.name == "SupplyBall" then
        pos = BALL_POSITION
    else
        pos = target.part.Position + CRATE_OFFSET
    end
    hrp.AssemblyLinearVelocity = Vector3.zero
    hrp.CFrame = CFrame.new(pos)
    return true
end

local function firePrompt(obj)
    if not fireproximityprompt then return false end
    local prompt = obj:FindFirstChildWhichIsA("ProximityPrompt", true)
    if not prompt then return false end
    return pcall(fireproximityprompt, prompt)
end

