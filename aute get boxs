local DYNAMIC = "Dyn" -- 動態項目的名稱標記,重新整理時只清除這些

local function createHeader(text, order, dynamic)
    local h = Instance.new("TextLabel")
    h.Name = dynamic and DYNAMIC or "Static"
    h.LayoutOrder = order
    h.Size = UDim2.new(1, -8, 0, 26)
    h.BackgroundColor3 = Color3.fromRGB(45, 45, 50)
    h.BorderSizePixel = 0
    h.Text = "  " .. text
    h.TextColor3 = Color3.fromRGB(255, 215, 0)
    h.TextSize = 14
    h.TextXAlignment = Enum.TextXAlignment.Left
    h.Font = Enum.Font.SourceSansBold
    h.Parent = Scroll
    return h
end

local function createBtn(text, order, dynamic, enabled, callback)
    local b = Instance.new("TextButton")
    b.Name = dynamic and DYNAMIC or "Static"
    b.LayoutOrder = order
    b.Size = UDim2.new(1, -8, 0, 30)
    b.BorderSizePixel = 0
    b.Text = text
    b.TextSize = 13
    b.Font = Enum.Font.SourceSans
    b.BackgroundColor3 = enabled and Color3.fromRGB(50, 50, 55) or Color3.fromRGB(30, 30, 32)
    b.TextColor3 = enabled and Color3.fromRGB(240, 240, 240) or Color3.fromRGB(100, 100, 100)
    b.Active = enabled
    b.AutoButtonColor = enabled
    b.Parent = Scroll
    if enabled and callback then
        b.MouseButton1Click:Connect(callback)
    end
    return b
end

local function flashText(btn, text, restore)
    btn.Text = text
    task.delay(1.2, function()
        if btn.Parent and btn.Text == text then btn.Text = restore end
    end)
end

-- ==================== 固定區:瞬按 ====================
createHeader("快捷瞬按 (" .. INSTANT_RANGE .. "距離內)", 1)
local INSTANT_TEXT = "一鍵瞬按 " .. INSTANT_RANGE .. " 內箱子/球"
local instantBtn = createBtn(INSTANT_TEXT, 2, false, true)
instantBtn.BackgroundColor3 = Color3.fromRGB(70, 90, 150)
instantBtn.Font = Enum.Font.SourceSansBold
instantBtn.MouseButton1Click:Connect(function()
    local hrp = getHRP()
    if not hrp then return end
    local count = 0
    for _, t in ipairs(collectTargets()) do
        if (hrp.Position - t.part.Position).Magnitude <= INSTANT_RANGE and firePrompt(t.object) then
            count += 1
        end
    end
    flashText(instantBtn, string.format("已瞬按 %d 個目標!", count), INSTANT_TEXT)
end)

-- ==================== 固定區:自動開關 (背景持續偵測) ====================
createHeader("自動模式", 3)
local autoBtn = createBtn("", 4, false, true)
autoBtn.Font = Enum.Font.SourceSansBold

local autoEnabled = false
local autoStatus = "待命中" -- 顯示在按鈕上的狀態

local function updateAutoBtn()
    if autoEnabled then
        autoBtn.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
        autoBtn.Text = "自動偵測: 開 (" .. autoStatus .. ")"
    else
        autoBtn.BackgroundColor3 = Color3.fromRGB(60, 120, 70)
        autoBtn.Text = "自動偵測: 關 (按下啟動)"
    end
end

-- 傳送到目標並持續嘗試按,直到物件消失或逾時
local function collectOne(target)
    if not teleportTo(target) then return false end
    task.wait(AUTO_SETTLE_DELAY)
    local deadline = os.clock() + AUTO_PRESS_TIMEOUT
    while autoEnabled and target.object.Parent and os.clock() < deadline do
        firePrompt(target.object)
        task.wait(AUTO_PRESS_INTERVAL)
    end
    return true
end

-- 找出最近且尚未處理過的目標 (球與箱子一視同仁)
local function pickNext(visited, fromPos)
    local best, bestDist
    for _, t in ipairs(collectTargets()) do
        if not visited[t.object] then
            local d = (fromPos - t.part.Position).Magnitude
            if not bestDist or d < bestDist then
                best, bestDist = t, d
            end
        end
    end
    return best
end

local autoThreadAlive = false

local function autoLoop()
    if autoThreadAlive then return end -- 避免重複開多個迴圈
    autoThreadAlive = true

    local visited = setmetatable({}, { __mode = "k" }) -- 弱引用,物件消失就自動清掉

    while autoEnabled do
        local hrp = getHRP()
        local target = hrp and pickNext(visited, hrp.Position)

        if target then
            -- 有新目標:記住原位,連續處理完整批後傳回
            local origin = hrp.CFrame
            local done = 0

            while autoEnabled and target do
                visited[target.object] = true
                done += 1
                autoStatus = string.format("處理第 %d 個", done)
                updateAutoBtn()
                collectOne(target)

                hrp = getHRP()
                target = hrp and pickNext(visited, hrp.Position)
            end

            -- 這一批結束 (或被關閉):傳送回原位
            hrp = getHRP()
            if hrp then
                hrp.AssemblyLinearVelocity = Vector3.zero
                hrp.CFrame = origin
            end
            autoStatus = "待命中"
            updateAutoBtn()
        else
            task.wait(AUTO_SCAN_INTERVAL)
        end
    end

    autoThreadAlive = false
    updateAutoBtn()
end

autoBtn.MouseButton1Click:Connect(function()
    autoEnabled = not autoEnabled
    autoStatus = "待命中"
    updateAutoBtn()
    if autoEnabled then
        task.spawn(autoLoop)
    end
end)

updateAutoBtn()

-- ==================== 動態區:箱子 / 球清單 ====================
local function buildSection(title, name, label, startOrder)
    createHeader(title, startOrder, true)
    local list = collectTargets(name)
    if #list == 0 then
        createBtn("目前無可用" .. label .. " (已停用)", startOrder + 1, true, false)
        return startOrder + 2
    end
    for i, t in ipairs(list) do
        local text
        if name == "SupplyBall" then
            text = string.format("傳送到 0,0,0 (補給球 #%d)", i)
        else
            text = string.format("傳送到%s #%d (Y: %.1f)", label, i, t.part.Position.Y)
        end
        createBtn(text, startOrder + i, true, true, function()
            teleportTo(t)
        end)
    end
    return startOrder + #list + 1
end

local function refreshUI()
    for _, child in ipairs(Scroll:GetChildren()) do
        if child.Name == DYNAMIC then child:Destroy() end
    end
    local order = buildSection("補給箱 (SupplyCrate)", "SupplyCrate", "箱子", 10)
    buildSection("補給球 (SupplyBall)", "SupplyBall", "補給球", order + 1)
end

local refreshQueued = false
local function queueRefresh()
    if refreshQueued then return end
    refreshQueued = true
    task.delay(0.3, function()
        refreshQueued = false
        refreshUI()
    end)
end

refreshUI()

workspace.ChildAdded:Connect(function(child)
    if TARGET_NAMES[child.Name] then queueRefresh() end
end)
workspace.ChildRemoved:Connect(function(child)
    if TARGET_NAMES[child.Name] then queueRefresh() end
end)
