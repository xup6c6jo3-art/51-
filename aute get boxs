-- 狀態變數 (SupplyBall 持續傳送狀態)
local ballLoopEnabled = false
local ballLoopConnection = nil

-- 建立分類標題標籤
local function createHeader(text)
    local header = Instance.new("TextLabel")
    header.Parent = Scroll
    header.Size = UDim2.new(1, -8, 0, 26)
    header.BackgroundColor3 = Color3.fromRGB(45, 45, 50)
    header.BorderSizePixel = 0
    header.Text = "  " .. text
    header.TextColor3 = Color3.fromRGB(255, 215, 0)
    header.TextSize = 14
    header.TextXAlignment = Enum.TextXAlignment.Left
    header.Font = Enum.Font.SourceSansBold
    return header
end

-- 建立一般按鈕 (用於箱子與功能)
local function createBtn(text, enabled, callback)
    local btn = Instance.new("TextButton")
    btn.Parent = Scroll
    btn.Size = UDim2.new(1, -8, 0, 30)
    btn.BackgroundColor3 = enabled and Color3.fromRGB(50, 50, 55) or Color3.fromRGB(30, 30, 32)
    btn.BorderSizePixel = 0
    btn.Text = text
    btn.TextColor3 = enabled and Color3.fromRGB(240, 240, 240) or Color3.fromRGB(100, 100, 100)
    btn.TextSize = 13
    btn.Font = Enum.Font.SourceSans
    btn.Active = enabled
    btn.AutoButtonColor = enabled
    
    if enabled and callback then
        btn.MouseButton1Click:Connect(function()
            callback()
        end)
    end
    return btn
end

-- 取得物件座標
local function getObjectPosition(obj)
    if obj:IsA("Model") then
        if obj.PrimaryPart then return obj.PrimaryPart.Position end
        local part = obj:FindFirstChildWhichIsA("BasePart")
        if part then return part.Position end
    elseif obj:IsA("BasePart") then
        return obj.Position
    end
    return nil
end

-- 取得物件對應的 Part (供持續傳送對齊用)
local function getObjectPart(obj)
    if not obj then return nil end
    if obj:IsA("Model") and obj.PrimaryPart then return obj.PrimaryPart end
    if obj:IsA("BasePart") then return obj end
    return obj:FindFirstChildWhichIsA("BasePart")
end

-- 設定角色穿牆 (Noclip)
local function setNoclip(enabled)
    local char = LocalPlayer.Character
    if char then
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = not enabled
            end
        end
    end
end

-- 重新整理整個介面與偵測邏輯
local function refreshUI()
    -- 清除舊的 UI 項目
    for _, child in ipairs(Scroll:GetChildren()) do
        if child:IsA("GuiObject") and child ~= UIListLayout then
            child:Destroy()
        end
    end

    -- ==================== 0. 快捷瞬按功能 (30距離內單次觸發) ====================
    createHeader("快捷瞬按 (30距離內)")
    local instantBtn = Instance.new("TextButton")
    instantBtn.Parent = Scroll
    instantBtn.Size = UDim2.new(1, -8, 0, 30)
    instantBtn.BackgroundColor3 = Color3.fromRGB(70, 90, 150)
    instantBtn.BorderSizePixel = 0
    instantBtn.Text = "一鍵瞬按 30 內箱子/球 (按一下執行)"
    instantBtn.TextColor3 = Color3.fromRGB(240, 240, 240)
    instantBtn.TextSize = 13
    instantBtn.Font = Enum.Font.SourceSansBold
    
    instantBtn.MouseButton1Click:Connect(function()
        if LocalPlayer.Character then
            local hrp = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                local count = 0
                for _, obj in ipairs(workspace:GetChildren()) do
                    if obj.Name == "SupplyCrate" or obj.Name == "SupplyBall" then
                        local pos = getObjectPosition(obj)
                        if pos and pos.Y <= 5000 then
                            local distance = (hrp.Position - pos).Magnitude
                            if distance <= 30 then
                                local prompt = obj:FindFirstChildWhichIsA("ProximityPrompt", true)
                                if prompt then
                                    pcall(function()
                                        fireproximityprompt(prompt)
                                        count = count + 1
                                    end)
                                end
                            end
                        end
                    end
                end
                -- 點擊後短暫顯示回饋文字
                instantBtn.Text = string.format("已瞬按 %d 個目標！", count)
                task.delay(1, function()
                    if instantBtn and instantBtn.Parent then
                        instantBtn.Text = "一鍵瞬按 30 內箱子/球 (按一下執行)"
                    end
                end)
            end
        end
    end)

    -- ==================== 1. SupplyCrate (箱子區塊) ====================
    createHeader("補給箱 (SupplyCrate)")
    local validCrates = {}
    
    for _, obj in ipairs(workspace:GetChildren()) do
        if obj.Name == "SupplyCrate" then
            local pos = getObjectPosition(obj)
            if pos and pos.Y <= 5000 then
                table.insert(validCrates, {object = obj, position = pos})
            end
        end
    end

    if #validCrates > 0 then
        for i, data in ipairs(validCrates) do
            local btnText = string.format("傳送到箱子 #%d (Y: %.1f)", i, data.position.Y)
            createBtn(btnText, true, function()
                local character = LocalPlayer.Character
                if character and character:FindFirstChild("HumanoidRootPart") then
                    character.HumanoidRootPart.CFrame = CFrame.new(data.position + Vector3.new(0, 3, 0))
                end
            end)
        end
    else
        createBtn("目前無可用補給箱 (已停用)", false, nil)
    end

    -- ==================== 2. SupplyBall (球區塊) ====================
    createHeader("補給球 (SupplyBall)")
    local validBalls = {}
    
    for _, obj in ipairs(workspace:GetChildren()) do
        if obj.Name == "SupplyBall" then
            local pos = getObjectPosition(obj)
            if pos and pos.Y <= 5000 then
                table.insert(validBalls, {object = obj, position = pos})
            end
        end
    end

    local hasBall = #validBalls > 0

    if not hasBall and ballLoopEnabled then
        ballLoopEnabled = false
        if ballLoopConnection then
            ballLoopConnection:Disconnect()
            ballLoopConnection = nil
        end
        setNoclip(false)
    end

    local ballBtn = Instance.new("TextButton")
    ballBtn.Parent = Scroll
    ballBtn.Size = UDim2.new(1, -8, 0, 30)
    
    if hasBall then
        ballBtn.BackgroundColor3 = ballLoopEnabled and Color3.fromRGB(180, 50, 50) or Color3.fromRGB(50, 50, 55)
        ballBtn.TextColor3 = Color3.fromRGB(240, 240, 240)
        ballBtn.Text = ballLoopEnabled and "持續傳送補給球: 開" or "持續傳送補給球: 關"
        ballBtn.Active = true
        ballBtn.AutoButtonColor = true
        
        ballBtn.MouseButton1Click:Connect(function()
            ballLoopEnabled = not ballLoopEnabled
            refreshUI()
            
            if ballLoopEnabled then
                if ballLoopConnection then ballLoopConnection:Disconnect() end
                
                ballLoopConnection = RunService.Stepped:Connect(function()
                    local targetObj = nil
                    for _, obj in ipairs(workspace:GetChildren()) do
                        if obj.Name == "SupplyBall" then
                            local p = getObjectPosition(obj)
                            if p and p.Y <= 5000 then
                                targetObj = obj
                                break
                            end
                        end
                    end
                    
                    if targetObj and LocalPlayer.Character then
                        local myHrp = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                        local targetPart = getObjectPart(targetObj)
                        
                        if myHrp and targetPart then
                            setNoclip(true)
                            myHrp.Velocity = Vector3.new(0, 0, 0)
                            myHrp.RotVelocity = Vector3.new(0, 0, 0)
                            myHrp.CFrame = targetPart.CFrame * CFrame.new(0, -5, 0)
                        end
                    else
                        ballLoopEnabled = false
                        if ballLoopConnection then
                            ballLoopConnection:Disconnect()
                            ballLoopConnection = nil
                        end
                        setNoclip(false)
                        refreshUI()
                    end
                end)
            else
                if ballLoopConnection then
                    ballLoopConnection:Disconnect()
                    ballLoopConnection = nil
                end
                setNoclip(false)
            end
        end)
    else
        ballBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 32)
        ballBtn.TextColor3 = Color3.fromRGB(100, 100, 100)
        ballBtn.Text = "目前無可用補給球 (已停用)"
        ballBtn.Active = false
        ballBtn.AutoButtonColor = false
    end
end

-- 初始化執行
refreshUI()

-- 即時監聽 workspace 內物件生成與移除
workspace.ChildAdded:Connect(function(child)
    if child.Name == "SupplyCrate" or child.Name == "SupplyBall" then
        task.wait(0.3)
        refreshUI()
    end
end)

workspace.ChildRemoved:Connect(function(child)
    if child.Name == "SupplyCrate" or child.Name == "SupplyBall" then
        refreshUI()
    end
end)
