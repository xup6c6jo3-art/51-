local CONFIG = {
	-- ...其他設定不變...
	MonsterScriptName = "AIScript", -- 改成你怪物底下那個腳本的實際名稱
}

-- 判斷類型：玩家 / 怪物 / 都不是(回傳 nil)
local function classify(model)
	if Players:GetPlayerFromCharacter(model) then
		return "Player"
	end
	if model:FindFirstChild(CONFIG.MonsterScriptName) then
		return "Monster"
	end
	return nil
end

local function tryAdd(inst)
	if not (inst:IsA("Humanoid") and inst.Parent and inst.Parent:IsA("Model")) then
		return
	end
	local model = inst.Parent

	local kind = classify(model)
	if kind then
		addTarget(model, kind)
		return
	end

	-- 怪物剛生成時，腳本可能還沒複製到客戶端，等一下再判斷
	task.spawn(function()
		if model:WaitForChild(CONFIG.MonsterScriptName, 5) then
			addTarget(model, "Monster")
		end
	end)
end
