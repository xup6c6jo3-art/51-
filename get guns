-- =========================================================
-- 物件自動排列 UI 腳本 (LocalScript)
-- 放置位置：StarterPlayer > StarterPlayerScripts
-- 功能：
--   1. 按鈕「傳送全部物件」：掃描一次，把找到的物件排到兩條線上
--   2. 開關「持續偵測」：每 2 秒掃描一次，只處理新出現的物件
--   3. 已經排過的物件不會重複傳送；物件消失後會釋放位置給新物件
--   4. 找不到的資料夾直接忽略
-- =========================================================

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

-- ================= 設定區 =================
local TARGET_Y = 1148
local BLOCK_SIZE = 5       -- 物件間隔
local SCAN_INTERVAL = 2    -- 持續偵測間隔（秒）
local YIELD_EVERY = 5      -- 每處理幾個物件讓出一次畫面，避免卡頓

local LINES = {
	{ Vector3.new(596.51, TARGET_Y, 785.83), Vector3.new(596.69, TARGET_Y, 715.76) },
	{ Vector3.new(614.35, TARGET_Y, 782.40), Vector3.new(614.96, TARGET_Y, 715.58) },
}

-- path：Workspace 底下的資料夾路徑（空表 = 直接在 Workspace 底下）
-- names：要抓的物件名稱（必須完全一致）
local SOURCES = {
	{ path = { "Floor 2" },       names = { "GetHEXGun", "GetRedMissile" } },
	{ path = { "IceZone" },       names = { "GetIceCrossbow" } },
	{ path = { "LavaZone" },      names = { "Escape" } },
	{ path = {},                  names = { "Exit" } },
	{ path = { "CorruptedZone" }, names = { "RGB - 9999 Cell" } },
	{ path = { "DeadGround" },    names = { "LXD - 9999 Cell" } },
	{ path = { "CyberLand" },     names = { "GetMechGun" } },
}
-- ==========================================

-- 把 names 轉成查表用的 set，查詢比 ipairs 快
for _, src in ipairs(SOURCES) do
	local set = {}
	for _, n in ipairs(src.names) do
		set[n] = true
	end
	src.nameSet = set
end

-- 預先計算所有排列位置
local slots = {}
for _, line in ipairs(LINES) do
	local a, b = line[1], line[2]
	local len = (b - a).Magnitude
	local count = math.floor(len / BLOCK_SIZE)
	for i = 0, count do
		table.insert(slots, { pos = a:Lerp(b, (i * BLOCK_SIZE) / len), item = nil })
	end
end

-- 已處理過的物件（弱引用，物件被銷毀後會自動回收）
local placed = setmetatable({}, { __mode = "k" })
local warnedFull = false

-- 釋放已消失物件佔用的位置
local function releaseSlots()
	for _, slot in ipairs(slots) do
		local item = slot.item
		if item and not item:IsDescendantOf(workspace) then
			slot.item = nil
		end
	end
	warnedFull = false
end

local function takeFreeSlot()
	for _, slot in ipairs(slots) do
		if not slot.item then
			return slot
		end
	end
	return nil
end

local function placeItem(item, pos)
	if item:IsA("BasePart") then
		item.CanCollide = false
		item.Anchored = true
	end
	for _, d in ipairs(item:GetDescendants()) do
		if d:IsA("BasePart") then
			d.CanCollide = false
			d.Anchored = true
		end
	end
	item:PivotTo(CFrame.new(pos))
end

local function resolveContainer(path)
	local node = workspace
	for _, name in ipairs(path) do
		node = node:FindFirstChild(name)
		if not node then
			return nil -- 資料夾不存在就忽略
		end
	end
	return node
end

-- UI 狀態更新（稍後賦值）
local updateStatus = function() end

local scanning = false
local function scan()
	if scanning then return 0 end
	scanning = true

	releaseSlots()
	local moved = 0

	for _, src in ipairs(SOURCES) do
		local container = resolveContainer(src.path)
		if container then
			for _, child in ipairs(container:GetChildren()) do
				if src.nameSet[child.Name] and not placed[child] then
					local slot = takeFreeSlot()
					if not slot then
						if not warnedFull then
							warnedFull = true
							warn("排列位置已滿，部分物件未排列")
						end
						scanning = false
						updateStatus()
						return moved
					end
					slot.item = child
					placed[child] = true
					placeItem(child, slot.pos)
					moved += 1
					if moved % YIELD_EVERY == 0 then
						task.wait()
					end
				end
			end
		end
	end

	scanning = false
	updateStatus()
	return moved
end

-- ================= UI =================
local gui = Instance.new("ScreenGui")
gui.Name = "ArrangeItemsUI"
gui.ResetOnSpawn = false
gui.Parent = playerGui

local frame = Instance.new("Frame")
frame.Size = UDim2.fromOffset(220, 150)
frame.Position = UDim2.fromOffset(20, 120)
frame.BackgroundColor3 = Color3.fromRGB(30, 30, 36)
frame.BorderSizePixel = 0
frame.Active = true
frame.Parent = gui
Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 10)

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, 0, 0, 28)
title.BackgroundTransparency = 1
title.Text = "物件排列工具 (可拖曳)"
title.TextColor3 = Color3.new(1, 1, 1)
title.Font = Enum.Font.SourceSansBold
title.TextSize = 16
title.Parent = frame

local function makeButton(text, y, color)
	local b = Instance.new("TextButton")
	b.Size = UDim2.new(1, -20, 0, 36)
	b.Position = UDim2.new(0, 10, 0, y)
	b.BackgroundColor3 = color
	b.BorderSizePixel = 0
	b.Text = text
	b.TextColor3 = Color3.new(1, 1, 1)
	b.Font = Enum.Font.SourceSansBold
	b.TextSize = 16
	b.AutoButtonColor = true
	b.Parent = frame
	Instance.new("UICorner", b).CornerRadius = UDim.new(0, 8)
	return b
end

local ON_COLOR = Color3.fromRGB(46, 160, 90)
local OFF_COLOR = Color3.fromRGB(150, 60, 60)

local runBtn = makeButton("傳送全部物件", 34, Color3.fromRGB(50, 110, 200))
local autoBtn = makeButton("持續偵測：關", 76, OFF_COLOR)

local status = Instance.new("TextLabel")
status.Size = UDim2.new(1, -20, 0, 24)
status.Position = UDim2.new(0, 10, 0, 118)
status.BackgroundTransparency = 1
status.TextColor3 = Color3.fromRGB(200, 200, 200)
status.Font = Enum.Font.SourceSans
status.TextSize = 14
status.Text = "已排列：0 / " .. #slots
status.Parent = frame

updateStatus = function()
	local used = 0
	for _, slot in ipairs(slots) do
		if slot.item then used += 1 end
	end
	status.Text = string.format("已排列：%d / %d", used, #slots)
end

-- 按鈕：單次傳送
runBtn.MouseButton1Click:Connect(function()
	local n = scan()
	status.Text = string.format("本次新傳送 %d 個", n)
	task.delay(1.5, updateStatus)
end)

-- 開關：持續偵測
local autoOn = false
local loopToken = 0

local function setAuto(on)
	autoOn = on
	autoBtn.Text = on and "持續偵測：開" or "持續偵測：關"
	autoBtn.BackgroundColor3 = on and ON_COLOR or OFF_COLOR

	loopToken += 1
	if on then
		local myToken = loopToken
		task.spawn(function()
			while autoOn and myToken == loopToken do
				scan()
				task.wait(SCAN_INTERVAL)
			end
		end)
	end
end

autoBtn.MouseButton1Click:Connect(function()
	setAuto(not autoOn)
end)

-- 拖曳視窗
do
	local dragging, dragStart, startPos
	frame.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = frame.Position
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch) then
			local delta = input.Position - dragStart
			frame.Position = UDim2.new(
				startPos.X.Scale, startPos.X.Offset + delta.X,
				startPos.Y.Scale, startPos.Y.Offset + delta.Y
			)
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)
end
