-- =========================================================
-- 偵測面板 UI (LocalScript)
-- 放置位置：StarterPlayer > StarterPlayerScripts
-- 外觀：畫面最上方掛著一個面板，右側有小方塊按鈕（▲/▼）可收起/展開
-- 功能：每 1 秒自動偵測 Workspace 裡有哪些指定資料夾，
--       並顯示對應名稱（骷顱頭 / 靜音 / 黑色 / RGB / 尖叫）
--   * 面板展開：持續顯示目前偵測到什麼
--   * 面板收起：偵測到東西（結果有變化）時，自動彈出 1 秒顯示，再自動收起
--   * 彈出途中按 ▲/▼：以你按的為準（立刻收起 / 展開，並取消自動收起）
-- =========================================================

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

-- ================= 設定區 =================
-- label：偵測到時顯示的文字
-- folder：Workspace 底下的資料夾名稱
-- item：資料夾裡的物件名稱（填 nil 代表只看資料夾，不檢查裡面的物件）
local TARGETS = {
	{ label = "骷顱頭", folder = "Castle",        item = nil },
	{ label = "靜音",   folder = "CyberLand",     item = nil },
	{ label = "黑色",   folder = "DeadGround",    item = nil },
	{ label = "RGB",    folder = "CorruptedZone", item = nil },
	{ label = "尖叫",   folder = "NightCity",     item = nil }, -- 資料夾會定時生成、之後會被刪除
}

local DETECT_INTERVAL = 1 -- 幾秒偵測一次
local PEEK_TIME = 1       -- 收起狀態下偵測到時，彈出顯示幾秒
-- ==========================================

local PANEL_W, PANEL_H = 300, 100
local TAB_W, TAB_H = 36, 28
local TWEEN_INFO = TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

-- ---------- UI ----------
local gui = Instance.new("ScreenGui")
gui.Name = "DetectPanelUI"
gui.ResetOnSpawn = false
gui.DisplayOrder = 10
gui.Parent = playerGui

-- 裁切容器：面板收起時不會跑到畫面外面去
local clip = Instance.new("Frame")
clip.Name = "Clip"
clip.Size = UDim2.fromOffset(PANEL_W, PANEL_H)
clip.Position = UDim2.new(0.5, -(PANEL_W + TAB_W) / 2, 0, 0)
clip.BackgroundTransparency = 1
clip.ClipsDescendants = true
clip.Parent = gui

local SHOWN_POS = UDim2.fromOffset(0, -10)
local HIDDEN_POS = UDim2.fromOffset(0, -(PANEL_H + 14))

local panel = Instance.new("Frame")
panel.Name = "Panel"
panel.Size = UDim2.fromOffset(PANEL_W, PANEL_H + 10)
panel.Position = SHOWN_POS
panel.BackgroundColor3 = Color3.fromRGB(30, 30, 36)
panel.BorderSizePixel = 0
panel.Parent = clip
Instance.new("UICorner", panel).CornerRadius = UDim.new(0, 10)

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, -20, 0, 20)
title.Position = UDim2.fromOffset(10, 18)
title.BackgroundTransparency = 1
title.Text = "偵測到了是："
title.TextColor3 = Color3.fromRGB(180, 180, 190)
title.Font = Enum.Font.SourceSansBold
title.TextSize = 16
title.TextXAlignment = Enum.TextXAlignment.Left
title.Parent = panel

local result = Instance.new("TextLabel")
result.Size = UDim2.new(1, -20, 0, 40)
result.Position = UDim2.fromOffset(10, 42)
result.BackgroundTransparency = 1
result.Text = "偵測中…"
result.TextColor3 = Color3.new(1, 1, 1)
result.Font = Enum.Font.SourceSansBold
result.TextSize = 24
result.TextWrapped = true
result.TextXAlignment = Enum.TextXAlignment.Left
result.TextYAlignment = Enum.TextYAlignment.Top
result.Parent = panel

local detail = Instance.new("TextLabel")
detail.Size = UDim2.new(1, -20, 0, 20)
detail.Position = UDim2.fromOffset(10, 82)
detail.BackgroundTransparency = 1
detail.Text = ""
detail.TextColor3 = Color3.fromRGB(130, 130, 140)
detail.Font = Enum.Font.SourceSans
detail.TextSize = 13
detail.TextXAlignment = Enum.TextXAlignment.Left
detail.TextTruncate = Enum.TextTruncate.AtEnd
detail.Parent = panel

-- 右側的小方塊（收起/展開）
local tab = Instance.new("TextButton")
tab.Name = "Tab"
tab.Size = UDim2.fromOffset(TAB_W, TAB_H)
tab.Position = UDim2.new(0.5, (PANEL_W - TAB_W) / 2, 0, 0)
tab.BackgroundColor3 = Color3.fromRGB(30, 30, 36)
tab.BorderSizePixel = 0
tab.Text = "▲"
tab.TextColor3 = Color3.new(1, 1, 1)
tab.Font = Enum.Font.SourceSansBold
tab.TextSize = 16
tab.Parent = gui
Instance.new("UICorner", tab).CornerRadius = UDim.new(0, 6)

-- ---------- 收起 / 展開 ----------
local shown = true       -- 面板目前實際是否露出來
local userExpanded = true -- 使用者自己選擇的狀態（展開 / 收起）
local panelTween
local peekToken = 0      -- 用來取消「彈出 1 秒後自動收起」

local function setShown(value)
	shown = value
	tab.Text = shown and "▲" or "▼"
	if panelTween then panelTween:Cancel() end
	panelTween = TweenService:Create(panel, TWEEN_INFO, {
		Position = shown and SHOWN_POS or HIDDEN_POS,
	})
	panelTween:Play()
end

-- 手動按 ▲/▼：以使用者為準，並取消正在倒數的自動收起
tab.MouseButton1Click:Connect(function()
	peekToken += 1
	userExpanded = not shown
	setShown(userExpanded)
end)

-- 收起狀態下偵測到東西：彈出 PEEK_TIME 秒後自動收回
local function peek()
	peekToken += 1
	local myToken = peekToken
	if not shown then
		setShown(true)
	end
	task.delay(PEEK_TIME, function()
		-- 期間若使用者按過按鈕、或又有新的彈出，就不處理
		if myToken ~= peekToken then return end
		if not userExpanded then
			setShown(false)
		end
	end)
end

-- ---------- 偵測 ----------
-- 記錄「已經彈出過、而且資料夾還在」的目標；資料夾消失後才會被清掉，之後再出現才會再彈
local seen = {}

local function detect()
	local labels, paths = {}, {}
	local current = {}
	local hasNew = false

	for _, t in ipairs(TARGETS) do
		local folder = workspace:FindFirstChild(t.folder)
		if folder and (t.item == nil or folder:FindFirstChild(t.item)) then
			table.insert(labels, t.label)
			table.insert(paths, t.item and (t.folder .. "/" .. t.item) or t.folder)
			current[t.folder] = true
			if not seen[t.folder] then
				hasNew = true -- 這個資料夾是剛出現的
			end
		end
	end

	-- 只保留目前還存在的；消失的就從 seen 移除，下次再出現才算新的
	seen = current

	if #labels > 0 then
		result.Text = table.concat(labels, "、")
		result.TextColor3 = Color3.fromRGB(120, 230, 150)
		detail.Text = table.concat(paths, ", ")
	else
		result.Text = "沒有偵測到"
		result.TextColor3 = Color3.fromRGB(230, 120, 120)
		detail.Text = ""
	end

	-- 有「新出現」的資料夾，而且面板是使用者收起的狀態 → 彈出 1 秒
	if hasNew and not userExpanded then
		peek()
	end
end

-- 預設自動偵測：每 DETECT_INTERVAL 秒一次
task.spawn(function()
	while gui.Parent do
		detect()
		task.wait(DETECT_INTERVAL)
	end
end)
