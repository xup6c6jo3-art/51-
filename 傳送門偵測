-- =========================================================
-- 偵測面板 UI (LocalScript)
-- 放置位置：StarterPlayer > StarterPlayerScripts
-- 外觀：畫面最上方掛著一個面板，右側有小方塊按鈕（▲/▼）可收起/展開
-- 功能：按「偵測」後，檢查 Workspace 裡有哪些指定資料夾，
--       並顯示對應名稱（骷顱頭 / 靜音 / 黑色 / RGB / 尖叫）
-- =========================================================

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

-- ================= 設定區 =================
-- label：偵測到時顯示的文字
-- folder：Workspace 底下的資料夾名稱
-- item：資料夾裡的物件名稱
local TARGETS = {
	{ label = "骷顱頭", folder = "Castle",        item = "Scarecrow" },
	{ label = "靜音",   folder = "CyberLand",     item = "Mech O' Lantern" },
	{ label = "黑色",   folder = "DeadGround",    item = "LXD - 9999 Cell" },
	{ label = "RGB",    folder = "CorruptedZone", item = "RGB - 9999 Cell" },
	{ label = "尖叫",   folder = "NightCity",     item = "NoSpawnKill" },
}

-- true  = 資料夾和裡面的物件都要存在才算偵測到（較準確）
-- false = 只要資料夾存在就算偵測到
local REQUIRE_ITEM = true
-- ==========================================

local PANEL_W, PANEL_H = 300, 120
local TAB_W, TAB_H = 36, 28
local TWEEN_INFO = TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

-- ---------- UI ----------
local gui = Instance.new("ScreenGui")
gui.Name = "DetectPanelUI"
gui.ResetOnSpawn = false
gui.DisplayOrder = 10
gui.Parent = playerGui

-- 裁切容器：面板收起時不會跑到畫面外面去
local clip = Instance.new("Frame")
clip.Name = "Clip"
clip.Size = UDim2.fromOffset(PANEL_W, PANEL_H)
clip.Position = UDim2.new(0.5, -(PANEL_W + TAB_W) / 2, 0, 0)
clip.BackgroundTransparency = 1
clip.ClipsDescendants = true
clip.Parent = gui

local SHOWN_POS = UDim2.fromOffset(0, -10)
local HIDDEN_POS = UDim2.fromOffset(0, -(PANEL_H + 14))

local panel = Instance.new("Frame")
panel.Name = "Panel"
panel.Size = UDim2.fromOffset(PANEL_W, PANEL_H + 10)
panel.Position = SHOWN_POS
panel.BackgroundColor3 = Color3.fromRGB(30, 30, 36)
panel.BorderSizePixel = 0
panel.Parent = clip
Instance.new("UICorner", panel).CornerRadius = UDim.new(0, 10)

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, -20, 0, 20)
title.Position = UDim2.fromOffset(10, 18)
title.BackgroundTransparency = 1
title.Text = "偵測到了是："
title.TextColor3 = Color3.fromRGB(180, 180, 190)
title.Font = Enum.Font.SourceSansBold
title.TextSize = 16
title.TextXAlignment = Enum.TextXAlignment.Left
title.Parent = panel

local result = Instance.new("TextLabel")
result.Size = UDim2.new(1, -20, 0, 40)
result.Position = UDim2.fromOffset(10, 42)
result.BackgroundTransparency = 1
result.Text = "尚未偵測"
result.TextColor3 = Color3.new(1, 1, 1)
result.Font = Enum.Font.SourceSansBold
result.TextSize = 24
result.TextWrapped = true
result.TextXAlignment = Enum.TextXAlignment.Left
result.TextYAlignment = Enum.TextYAlignment.Top
result.Parent = panel

local detail = Instance.new("TextLabel")
detail.Size = UDim2.fromOffset(180, 20)
detail.Position = UDim2.fromOffset(10, 100)
detail.BackgroundTransparency = 1
detail.Text = ""
detail.TextColor3 = Color3.fromRGB(130, 130, 140)
detail.Font = Enum.Font.SourceSans
detail.TextSize = 13
detail.TextXAlignment = Enum.TextXAlignment.Left
detail.TextTruncate = Enum.TextTruncate.AtEnd
detail.Parent = panel

local detectBtn = Instance.new("TextButton")
detectBtn.Size = UDim2.fromOffset(90, 32)
detectBtn.AnchorPoint = Vector2.new(1, 1)
detectBtn.Position = UDim2.new(1, -10, 1, -10)
detectBtn.BackgroundColor3 = Color3.fromRGB(50, 110, 200)
detectBtn.BorderSizePixel = 0
detectBtn.Text = "偵測"
detectBtn.TextColor3 = Color3.new(1, 1, 1)
detectBtn.Font = Enum.Font.SourceSansBold
detectBtn.TextSize = 18
detectBtn.Parent = panel
Instance.new("UICorner", detectBtn).CornerRadius = UDim.new(0, 8)

-- 右側的小方塊（收起/展開）
local tab = Instance.new("TextButton")
tab.Name = "Tab"
tab.Size = UDim2.fromOffset(TAB_W, TAB_H)
tab.Position = UDim2.new(0.5, (PANEL_W - TAB_W) / 2, 0, 0)
tab.BackgroundColor3 = Color3.fromRGB(30, 30, 36)
tab.BorderSizePixel = 0
tab.Text = "▲"
tab.TextColor3 = Color3.new(1, 1, 1)
tab.Font = Enum.Font.SourceSansBold
tab.TextSize = 16
tab.Parent = gui
Instance.new("UICorner", tab).CornerRadius = UDim.new(0, 6)

-- ---------- 收起 / 展開 ----------
local expanded = true
local panelTween

tab.MouseButton1Click:Connect(function()
	expanded = not expanded
	tab.Text = expanded and "▲" or "▼"
	if panelTween then panelTween:Cancel() end
	panelTween = TweenService:Create(panel, TWEEN_INFO, {
		Position = expanded and SHOWN_POS or HIDDEN_POS,
	})
	panelTween:Play()
end)

-- ---------- 偵測 ----------
local detecting = false

local function detect()
	if detecting then return end
	detecting = true

	local labels, paths = {}, {}
	for _, t in ipairs(TARGETS) do
		local folder = workspace:FindFirstChild(t.folder)
		if folder and (not REQUIRE_ITEM or folder:FindFirstChild(t.item)) then
			table.insert(labels, t.label)
			table.insert(paths, t.folder .. "/" .. t.item)
		end
	end

	if #labels > 0 then
		result.Text = table.concat(labels, "、")
		result.TextColor3 = Color3.fromRGB(120, 230, 150)
		detail.Text = table.concat(paths, ", ")
	else
		result.Text = "沒有偵測到"
		result.TextColor3 = Color3.fromRGB(230, 120, 120)
		detail.Text = ""
	end

	detecting = false
end

detectBtn.MouseButton1Click:Connect(detect)
