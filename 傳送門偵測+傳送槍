-- ================= 功能：偵測 =================
local detecting = false

local function detect()
	if detecting then return end
	detecting = true

	local labels, paths = {}, {}
	for _, t in ipairs(TARGETS) do
		local folder = workspace:FindFirstChild(t.folder)
		if folder and (not REQUIRE_ITEM or folder:FindFirstChild(t.item)) then
			table.insert(labels, t.label)
			table.insert(paths, t.folder .. "/" .. t.item)
		end
	end

	if #labels > 0 then
		result.Text = table.concat(labels, "、")
		result.TextColor3 = Color3.fromRGB(120, 230, 150)
		detail.Text = table.concat(paths, ", ")
	else
		result.Text = "沒有偵測到"
		result.TextColor3 = Color3.fromRGB(230, 120, 120)
		detail.Text = ""
	end

	detecting = false
end

detectBtn.MouseButton1Click:Connect(detect)

-- ================= 功能：排列 =================
-- 把 names 轉成查表用的 set，查詢比 ipairs 快
for _, src in ipairs(SOURCES) do
	local set = {}
	for _, n in ipairs(src.names) do
		set[n] = true
	end
	src.nameSet = set
end

-- 預先計算所有排列位置
local slots = {}
for _, line in ipairs(LINES) do
	local a, b = line[1], line[2]
	local len = (b - a).Magnitude
	local count = math.floor(len / BLOCK_SIZE)
	for i = 0, count do
		table.insert(slots, { pos = a:Lerp(b, (i * BLOCK_SIZE) / len), item = nil })
	end
end

-- 已處理過的物件（弱引用，物件被銷毀後會自動回收）
local placed = setmetatable({}, { __mode = "k" })
local warnedFull = false

local function updateStatus()
	local used = 0
	for _, slot in ipairs(slots) do
		if slot.item then used += 1 end
	end
	status.Text = string.format("已排列：%d / %d", used, #slots)
end
updateStatus()

-- 釋放已消失物件佔用的位置
local function releaseSlots()
	for _, slot in ipairs(slots) do
		local item = slot.item
		if item and not item:IsDescendantOf(workspace) then
			slot.item = nil
		end
	end
	warnedFull = false
end

local function takeFreeSlot()
	for _, slot in ipairs(slots) do
		if not slot.item then
			return slot
		end
	end
	return nil
end

-- 遞歸尋找主零件（用來當對位基準）
-- 優先順序：自己是 BasePart → 底下任何層的 Head → PrimaryPart → 最大的可見零件
local function getMainPart(item)
	if item:IsA("BasePart") then
		return item
	end

	local head = item:FindFirstChild("Head", true)
	if head and head:IsA("BasePart") then
		return head
	end

	if item:IsA("Model") and item.PrimaryPart then
		return item.PrimaryPart
	end

	-- 找體積最大的零件；先略過透明的（常是隱形的觸發/碰撞用零件）
	local best, bestVol = nil, -1
	local bestAny, bestAnyVol = nil, -1
	for _, d in ipairs(item:GetDescendants()) do
		if d:IsA("BasePart") then
			local s = d.Size
			local vol = s.X * s.Y * s.Z
			if vol > bestAnyVol then
				bestAny, bestAnyVol = d, vol
			end
			if d.Transparency < 1 and vol > bestVol then
				best, bestVol = d, vol
			end
		end
	end
	return best or bestAny
end

local function getBounds(item)
	if item:IsA("Model") then
		return item:GetBoundingBox()
	end
	return item.CFrame, item.Size
end

local function placeItem(item, pos)
	-- 先鎖住所有零件（遞歸），避免物理推擠
	if item:IsA("BasePart") then
		item.CanCollide = false
		item.Anchored = true
	end
	for _, d in ipairs(item:GetDescendants()) do
		if d:IsA("BasePart") then
			d.CanCollide = false
			d.Anchored = true
		end
	end

	if not (item:IsA("Model") or item:IsA("BasePart")) then
		warn("無法移動（不是 Model 或 BasePart）：", item:GetFullName())
		return
	end

	local mainPart = getMainPart(item)
	if not mainPart then
		-- 找不到任何零件，只好退回用 Pivot
		item:PivotTo(CFrame.new(pos))
		return
	end

	-- 讓「主零件」剛好落在目標位置：整個物件平移同樣的位移量，保持原本方向與形狀
	item:PivotTo(item:GetPivot() + (pos - mainPart.Position))

	-- 可選：讓物件底部貼齊 TARGET_Y，避免陷進地板
	if STAND_ON_Y then
		local cf, size = getBounds(item)
		local dy = TARGET_Y - (cf.Position.Y - size.Y / 2)
		item:PivotTo(item:GetPivot() + Vector3.new(0, dy, 0))
	end
end

local function resolveContainer(path)
	local node = workspace
	for _, name in ipairs(path) do
		node = node:FindFirstChild(name)
		if not node then
			return nil -- 資料夾不存在就忽略
		end
	end
	return node
end

local scanning = false
local function scan()
	if scanning then return 0 end
	scanning = true

	releaseSlots()
	local moved = 0

	for _, src in ipairs(SOURCES) do
		local container = resolveContainer(src.path)
		if container then
			for _, child in ipairs(container:GetChildren()) do
				if src.nameSet[child.Name] and not placed[child] then
					local slot = takeFreeSlot()
					if not slot then
						if not warnedFull then
							warnedFull = true
							warn("排列位置已滿，部分物件未排列")
						end
						scanning = false
						updateStatus()
						return moved
					end
					slot.item = child
					placed[child] = true
					placeItem(child, slot.pos)
					moved += 1
					if moved % YIELD_EVERY == 0 then
						task.wait()
					end
				end
			end
		end
	end

	scanning = false
	updateStatus()
	return moved
end

-- 按鈕：單次傳送
runBtn.MouseButton1Click:Connect(function()
	local n = scan()
	status.Text = string.format("本次新傳送 %d 個", n)
	task.delay(1.5, updateStatus)
end)

-- 開關：持續偵測
local autoOn = false
local loopToken = 0

local function setAuto(on)
	autoOn = on
	autoBtn.Text = on and "持續偵測：開" or "持續偵測：關"
	autoBtn.BackgroundColor3 = on and ON_COLOR or OFF_COLOR

	loopToken += 1
	if on then
		local myToken = loopToken
		task.spawn(function()
			while autoOn and myToken == loopToken do
				scan()
				task.wait(SCAN_INTERVAL)
			end
		end)
	end
end

autoBtn.MouseButton1Click:Connect(function()
	setAuto(not autoOn)
end)
