local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local player = Players.LocalPlayer

local INTERVAL = 2

local function move(obj, cf)
	if obj:IsA("BasePart") or obj:IsA("Model") then
		obj:PivotTo(cf)
	end
end

while true do
	task.wait(INTERVAL)

	local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not hrp then continue end
	local cf = hrp.CFrame

	-- Workspace 直接底下（一直都在）
	for _, obj in ipairs(Workspace:GetChildren()) do
		if obj.Name == "NoSpawnKill" then move(obj, cf) end
	end

	-- Ground > NoSpawnKills（一直都在）
	local ground = Workspace:FindFirstChild("Ground")
	local folder = ground and ground:FindFirstChild("NoSpawnKills")
	if folder then
		for _, obj in ipairs(folder:GetChildren()) do move(obj, cf) end
	end

	-- NightCity（不一定有，沒有就跳過）
	local nightCity = Workspace:FindFirstChild("NightCity")
	if nightCity then
		for _, obj in ipairs(nightCity:GetChildren()) do
			if obj.Name == "NoSpawnKill" then move(obj, cf) end
		end
	end
end
