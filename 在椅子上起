-- LocalScript（測試用：傳送過去 + 用 firetouchinterest 送出「碰到了」）
-- 需要執行器支援 firetouchinterest，一般 Studio 的 LocalScript 沒有這個函式
-- 放在 StarterPlayer > StarterPlayerScripts（或 StarterGui）

local Players = game:GetService("Players")
local player = Players.LocalPlayer

-- ====== 設定 ======
local FIRST = 0
local LAST = 6
local DELAY = 0.5           -- 每個檢查點之間的秒數
local HEIGHT_OFFSET = 0     -- 傳送時比門高多少 studs
local TOUCH_DOOR = true     -- 對 Closedoor 送碰到
local TOUCH_HITBOX = true   -- 對 HitBox 也送碰到（不確定伺服器看哪個，兩個都送）
local TOUCH_WAIT = 0.05     -- 開始碰到 → 結束碰到 之間的秒數
-- ==================

if not firetouchinterest then
	warn("[CartTouchTest] 這個環境沒有 firetouchinterest，只會傳送，不會送碰到")
end

-- UI
local gui = Instance.new("ScreenGui")
gui.Name = "CartTouchTestUI"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

local button = Instance.new("TextButton")
button.Size = UDim2.fromOffset(160, 50)
button.Position = UDim2.new(0, 20, 0.5, 35)
button.BackgroundColor3 = Color3.fromRGB(46, 120, 200)
button.TextColor3 = Color3.new(1, 1, 1)
button.Font = Enum.Font.SourceSansBold
button.TextSize = 22
button.Text = "傳送+碰到"
button.Parent = gui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 8)
corner.Parent = button

local function readPoint(checker)
	local p = checker:FindFirstChild("Point")
	if p and p:IsA("ValueBase") and type(p.Value) == "number" then
		return p.Value
	end
	return nil
end

local function collectCheckers()
	local list = {}
	for _, inst in ipairs(workspace:GetDescendants()) do
		if inst.Name == "CartChecker" then
			local n = readPoint(inst)
			if n then
				list[n] = inst
			end
		end
	end
	return list
end

local function getCFrame(obj)
	if obj:IsA("BasePart") then
		return obj.CFrame
	elseif obj:IsA("Model") then
		return obj:GetPivot()
	end
	local part = obj:FindFirstChildWhichIsA("BasePart", true)
	return part and part.CFrame or nil
end

local function getVehicle(humanoid)
	local seat = humanoid and humanoid.SeatPart
	if not seat then
		return nil
	end
	local top = seat:FindFirstAncestorOfClass("Model")
	while top and top.Parent and top.Parent ~= workspace and top.Parent:IsA("Model") do
		top = top.Parent
	end
	return top
end

local function zeroVelocity(root)
	for _, d in ipairs(root:GetDescendants()) do
		if d:IsA("BasePart") then
			d.AssemblyLinearVelocity = Vector3.zero
			d.AssemblyAngularVelocity = Vector3.zero
		end
	end
	if root:IsA("BasePart") then
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero
	end
end

-- 對 target 送出碰到：角色的 HumanoidRootPart 和座位（載具）都送
local function touch(target)
	if not firetouchinterest or not target or not target:IsA("BasePart") then
		return
	end
	local char = player.Character
	local humanoid = char and char:FindFirstChildOfClass("Humanoid")
	local root = char and char:FindFirstChild("HumanoidRootPart")
	local seat = humanoid and humanoid.SeatPart

	for _, mine in ipairs({ root, seat }) do
		if mine then
			firetouchinterest(mine, target, 0) -- 開始碰到
		end
	end
	task.wait(TOUCH_WAIT)
	for _, mine in ipairs({ root, seat }) do
		if mine then
			firetouchinterest(mine, target, 1) -- 結束碰到
		end
	end
end

local function teleportAndTouch(checker)
	local char = player.Character
	local humanoid = char and char:FindFirstChildOfClass("Humanoid")
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not root then
		return false
	end

	local door = checker:FindFirstChild("Closedoor", true)
	if not door then
		warn(checker:GetFullName() .. " 底下找不到 Closedoor，已跳過")
		return false
	end
	local doorCF = getCFrame(door)
	if not doorCF then
		return false
	end
	local targetCF = doorCF + Vector3.new(0, HEIGHT_OFFSET, 0)

	local vehicle = getVehicle(humanoid)
	if vehicle then
		vehicle:PivotTo(targetCF)
		zeroVelocity(vehicle)
	else
		char:PivotTo(targetCF)
		zeroVelocity(char)
	end

	task.wait(0.05) -- 讓位置先同步一下再送碰到

	if TOUCH_DOOR then
		touch(door)
	end
	if TOUCH_HITBOX then
		touch(checker:FindFirstChild("HitBox", true))
	end
	return true
end

local running = false
local runId = 0

local function setIdle()
	running = false
	button.Text = "傳送+碰到"
	button.BackgroundColor3 = Color3.fromRGB(46, 120, 200)
end

button.MouseButton1Click:Connect(function()
	if running then
		runId += 1
		setIdle()
		return
	end

	running = true
	runId += 1
	local myId = runId
	button.Text = "停止"
	button.BackgroundColor3 = Color3.fromRGB(200, 60, 60)

	local checkers = collectCheckers()

	for n = FIRST, LAST do
		if myId ~= runId then
			return
		end

		local checker = checkers[n]
		if checker then
			local ok = teleportAndTouch(checker)
			print("[CartTouchTest] Point", n, ok and "已傳送並送出碰到" or "失敗/跳過")
		else
			warn("[CartTouchTest] 找不到 Point = " .. n .. " 的 CartChecker")
		end

		task.wait(DELAY)
	end

	if myId == runId then
		setIdle()
	end
end)
