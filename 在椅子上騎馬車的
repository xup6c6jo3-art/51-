-- 傳送選單 + 重新進入遊戲按鈕（重進後自動再執行這個腳本）
-- 用執行器執行即可（需要 loadstring 與 queue_on_teleport）
local SOURCE = [==[
local SRC = ...
local Players = game:GetService("Players")
local TeleportService = game:GetService("TeleportService")
local player = Players.LocalPlayer

-- 7 個傳送點（X, Y, Z）
local locations = {
	Vector3.new(-236.96, 569.34, 204.60),
	Vector3.new(-181.86, 562.56, 791.25),
	Vector3.new(16.64, 875.74, 321.64),
	Vector3.new(855.02, 889.05, 706.35),
	Vector3.new(-897.30, 999.23, -58.17),
	Vector3.new(-146.22, 999.17, 1308.14),
	Vector3.new(259.62, 658.81, 956.98),
}

-- 避免重複建立介面
local pg = player:WaitForChild("PlayerGui")
local old = pg:FindFirstChild("TeleportGui")
if old then old:Destroy() end

local totalHeight = 40 + #locations * 38 + 42

local gui = Instance.new("ScreenGui")
gui.Name = "TeleportGui"
gui.ResetOnSpawn = false
gui.Parent = pg

local frame = Instance.new("Frame")
frame.Size = UDim2.new(0, 180, 0, totalHeight)
frame.Position = UDim2.new(0, 20, 0.5, -(totalHeight / 2))
frame.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
frame.BorderSizePixel = 0
frame.Active = true
frame.Draggable = true
frame.Parent = gui
Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 10)

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, 0, 0, 36)
title.BackgroundTransparency = 1
title.Text = "傳送選單"
title.TextColor3 = Color3.new(1, 1, 1)
title.Font = Enum.Font.GothamBold
title.TextSize = 18
title.Parent = frame

local function teleportTo(pos)
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if hrp then
		hrp.CFrame = CFrame.new(pos)
	end
end

for i, pos in ipairs(locations) do
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(1, -20, 0, 32)
	btn.Position = UDim2.new(0, 10, 0, 40 + (i - 1) * 38)
	btn.BackgroundColor3 = Color3.fromRGB(60, 120, 220)
	btn.TextColor3 = Color3.new(1, 1, 1)
	btn.Font = Enum.Font.Gotham
	btn.TextSize = 16
	btn.Text = "傳送到第 " .. i .. " 個"
	btn.BorderSizePixel = 0
	btn.Parent = frame
	Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)
	btn.MouseButton1Click:Connect(function()
		teleportTo(pos)
	end)
end

-- 底部：重新進入遊戲按鈕
local rejoin = Instance.new("TextButton")
rejoin.Size = UDim2.new(1, -20, 0, 32)
rejoin.Position = UDim2.new(0, 10, 0, 40 + #locations * 38 + 4)
rejoin.BackgroundColor3 = Color3.fromRGB(200, 60, 60)
rejoin.TextColor3 = Color3.new(1, 1, 1)
rejoin.Font = Enum.Font.GothamBold
rejoin.TextSize = 16
rejoin.Text = "重新進入遊戲"
rejoin.BorderSizePixel = 0
rejoin.Parent = frame
Instance.new("UICorner", rejoin).CornerRadius = UDim.new(0, 8)

rejoin.MouseButton1Click:Connect(function()
	rejoin.Text = "重新進入中..."
	-- 先排程：重進後自動再執行這個腳本
	local q = queue_on_teleport or (syn and syn.queue_on_teleport) or (fluxus and fluxus.queue_on_teleport)
	if q and SRC then
		q("local s = [==[" .. SRC .. "]==] loadstring(s)(s)")
	end
	-- 再重新進入同一個遊戲
	if #Players:GetPlayers() <= 1 then
		player:Kick("\n重新進入中...")
		task.wait()
		TeleportService:Teleport(game.PlaceId, player)
	else
		TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, player)
	end
end)
]==]

loadstring(SOURCE)(SOURCE)
